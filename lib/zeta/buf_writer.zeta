package zeta::buf_writer;

import zeta::io_channel.ReadChannel;
import zeta::io_channel.WriteChannel;
import zeta::io_error.IOError;
import zeta::result.Result;
import zeta::debug;
import zeta::sync::spinlock.SpinLock;
import zeta::utils::mallocator.Mallocator;
import zeta::alloc::allocator.Allocator;
import zeta::utils::array_list.ArrayList;

const DEFAULT_FLUSH_THRESHOLD: usize = 4096;

struct BufWriter<W: WriteChannel, A: Allocator = Mallocator> {
    inner: W,
    buffer: ArrayList<u8, A>,
    lock: SpinLock,
    threshold: usize,
}
impl<W: WriteChannel, A: Allocator = Mallocator> BufWriter<W, A> {
    func new(inner: W): BufWriter<W, Mallocator> {
        let alloc: Mallocator = Mallocator {};
        return BufWriter.new_with_threshold_in(inner, alloc, DEFAULT_FLUSH_THRESHOLD);
    }

    func new_in(inner: W, alloc: A): BufWriter<W, A> {
        return BufWriter.new_with_threshold_in(inner, alloc, DEFAULT_FLUSH_THRESHOLD);
    }

    func new_with_threshold(inner: W, threshold: usize): BufWriter<W, Mallocator> {
        let alloc: Mallocator = Mallocator {};
        return BufWriter.new_with_threshold_in(inner, alloc, threshold);
    }

    func new_with_threshold_in(inner: W, alloc: A, threshold: usize): BufWriter<W, A> {
        return BufWriter<W, A> {
            inner,
            buffer: ArrayList.with_capacity_in<u8, A>(threshold, alloc),
            lock: SpinLock.new(),
            threshold,
        };
    }

    func flush(&mut this): Result<bool, IOError> {
        this.lock.lock();
        let result: Result<void, IOError> = this.flush_locked();
        this.lock.unlock();
        return match (result) {
            case Result.Ok { value } -> Result.Ok { value: true },
            case Result.Err { error } -> Result.Err { error },
        };
    }

    func flush_locked(&mut this): Result<void, IOError> {
        if (this.buffer.len() == 0) {
            return Result.Ok { value: void };
        }
        let result: Result<void, IOError> = unsafe {
            this.inner.write_all(this.buffer.as_slice())
        };
        this.buffer.clear();
        return result;
    }

    func write(&mut this, bytes: &[]u8): Result<usize, IOError> {
        unsafe { return this.write_raw(bytes); };
    }

    func write_all(&mut this, bytes: &[]u8): Result<usize, IOError> {
        let mut written: usize = 0;
        while (written < bytes.len) {
            let n: usize = match (unsafe { this.write_raw(bytes[written..<bytes.len]) }) {
                case Result.Ok { value } -> value,
                case Result.Err { error } -> return Result.Err { error },
            };
            if (n == 0) {
                return Result.Err { error: IOError.WriteZero };
            }
            written += n;
        }
        return Result.Ok { value: written };
    }

    func writeln(&mut this, s: str): Result<bool, IOError> {
        return match (this.write_all(s.as_bytes())) {
            case Result.Err { error } -> Result.Err { error },
            case Result.Ok { value } -> this.write_all("\n".as_bytes()),
        }
    }
}

impl<W: WriteChannel, A: Allocator> BufWriter<W, A> by WriteChannel {
    unsafe func write_raw(&mut this, bytes: &[]u8): Result<usize, IOError> {
        this.lock.lock();
        for (let i: usize = 0; i < bytes.len; i += 1) {
            this.buffer.push(bytes[i]);
        }
        let mut result: Result<usize, IOError> = Result.Ok { value: bytes.len };
        if (this.buffer.len() >= this.threshold) {
            result = match (this.flush_locked()) {
                case Result.Ok { value } -> Result.Ok { value: bytes.len },
                case Result.Err { error } -> Result.Err { error },
            };
        }
        this.lock.unlock();
        return result;
    }
}

impl<W: WriteChannel, A: Allocator> BufWriter<W, A> by Drop {
    func drop(mut this) {
        match (this.flush()) {
            case Result.Ok { value } -> {},
            case Result.Err { error } -> {
                debug.debug_panic("BufWriter: failed to flush on drop"); // TODO: This really needs formatting soon
            },
        }
    }
}

struct BufReader<R: ReadChannel, A: Allocator = Mallocator> {
    inner: R,
    buffer: ArrayList<u8, A>,
    pos: usize,
}
impl<R: ReadChannel, A: Allocator = Mallocator> BufReader<R, A> {
    func new(inner: R): BufReader<R, Mallocator> {
        let alloc: Mallocator = Mallocator {};
        return BufReader.new_in(inner, alloc);
    }

    func new_in(inner: R, alloc: A): BufReader<R, A> {
        return BufReader<R, A> {
            inner,
            buffer: ArrayList.with_capacity_in<u8, A>(DEFAULT_FLUSH_THRESHOLD, alloc),
            pos: 0,
        };
    }

    func fill_buffer(&mut this): Result<usize, IOError> {
        this.buffer.clear();
        this.pos = 0;
        let mut chunk: [4096]u8 = uninit;
        let n: usize = match (unsafe { this.inner.read_raw(&mut chunk) }) {
            case Result.Ok { value } -> value,
            case Result.Err { error } -> return Result.Err { error },
        };
        for (let i: usize = 0; i < n; i += 1) {
            this.buffer.push(chunk[i]);
        }
        return Result.Ok { value: n };
    }

    func read_exact(&mut this, buffer: &[]u8): Result<usize, IOError> {
        let mut filled: usize = 0;
        while (filled < buffer.len) {
            let n: usize = match (unsafe { this.read_raw(buffer[filled..<buffer.len]) }) {
                case Result.Ok { value } -> value,
                case Result.Err { error } -> return Result.Err { error },
            };
            if (n == 0) {
                return Result.Err { error: IOError.UnexpectedEof };
            }
            filled += n;
        }
        return Result.Ok { value: filled };
    }

    func skip(&mut this, count: usize): Result<usize, IOError> {
        //let mut remaining: usize = count;
        //let mut chunk: [4096]u8 = undefined;
        //while (remaining > 0) {
        //    let want: usize = if (remaining < 4096) { remaining } else { 4096 };
        //    let n: usize = match (unsafe { this.read_raw(chunk[0..want]) }) {
        //        case Result.Ok { value } -> value,
        //        case Result.Err { error } -> return Result.Err { error },
        //    };
        //    if (n == 0) { break; }
        //    remaining -= n;
        //}
        //return Result.Ok { value: count - remaining };
        return Result.Ok { value: count };
    }

    func read_to_end<A: Allocator>(&mut this, out: &ArrayList<u8, A>): Result<usize, IOError> {
        let mut total: usize = 0;
        let mut chunk: [4096]u8 = uninit;
        while (true) {
            let n: usize = match (unsafe { this.read_raw(&chunk) }) {
                case Result.Ok { value } -> value,
                case Result.Err { error } -> return Result.Err { error },
            };
            if (n == 0) { break; }
            for (let i: usize = 0; i < n; i += 1) {
                out.push(chunk[i]);
            }
            total += n;
        }
        return Result.Ok { value: total };
    }

    func read_line<A: Allocator>(&mut this, out: &String<A>): Result<usize, IOError> {
        let mut total: usize = 0;
        let mut byte: [1]u8 = uninit;
        while (true) {
            let n: usize = match (unsafe { this.read_raw(&mut byte) }) {
                case Result.Ok { value } -> value,
                case Result.Err { error } -> return Result.Err { error },
            };
            if (n == 0) { break; }
            total += 1;
            if (byte[0] == '\n' as u8) { break; }
            out.push_byte(byte[0]);
        }
        return Result.Ok { value: total };
    }
}

impl<R: ReadChannel, A: Allocator> BufReader<R, A> by ReadChannel {
    unsafe func read_raw(&mut this, out: &mut []u8): Result<usize, IOError> {
        if (this.pos >= this.buffer.len()) {
            let n: usize = match (this.fill_buffer()) {
                case Result.Ok { value } -> value,
                case Result.Err { error } -> return Result.Err { error },
            };
            if (n == 0) {
                return Result.Ok { value: 0 };
            }
        }
        let mut copied: usize = 0;
        while (copied < out.len && this.pos < this.buffer.len()) {
            out[copied] = *this.buffer.get(this.pos);
            copied += 1;
            this.pos += 1;
        }
        return Result.Ok { value: copied };
    }
}
