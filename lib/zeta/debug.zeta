package zeta::debug;

import zeta::libc;
import zeta::file.FileWriter;
import zeta::file.File;
import zeta::io_error.IOError;
import zeta::result.Result;

import zeta::strings;
import zeta::libc;

func debug_panic(msg: str): never {
    let fd: i32 = 2;
    let prefix: &[]u8 = "panic: ".as_bytes();
    let body: &[]u8 = msg.as_bytes();
    let nl: &[]u8 = "\n".as_bytes();
    unsafe {
        let _: isize = libc.write(fd, prefix as [*]const void, prefix.len);
        let _: isize = libc.write(fd, body as [*]const void, body.len);
        let _: isize = libc.write(fd, nl as [*]const void, nl.len);
        libc.abort();
    }
    $unreachable();
}

func assert(cond: bool, msg: str) {
    if (!cond) {
        debug_panic(msg);
    }
}
