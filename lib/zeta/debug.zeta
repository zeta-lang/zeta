package zeta::debug;

import zeta::libc;
import zeta::file.FileWriter;
import zeta::file.File;
import zeta::io_error.IOError;
import zeta::result.Result;

// TODO: move to strings.zeta
impl str {
    unsafe func from_utf8(bytes: &[]u8): Result<str, Utf8ConversionError> {
        return Result.Ok { value: "" };
    }
    unsafe func from_utf8_unchecked(bytes: &[]u8): str {
        return "";
    }

    func as_bytes(&this): &[]u8 {
        let len: usize = unsafe { *($reinterpret<[*]const usize>(this)) };
        unsafe {
            let data_ptr: [*]const u8 = $reinterpret<[*]const u8>($reinterpret<usize>(this) + 8);
            return data_ptr[0..<len];
        }
    }
}

struct Utf8ConversionError {}


import zeta::libc;

func debug_panic(msg: str): never {
    let fd: i32 = 2;
    let prefix: &[]u8 = "panic: ".as_bytes();
    let body: &[]u8 = msg.as_bytes();
    let nl: &[]u8 = "\n".as_bytes();
    unsafe {
        let _: isize = libc.write(fd, prefix as [*]const void, prefix.len);
        let _: isize = libc.write(fd, body as [*]const void, body.len);
        let _: isize = libc.write(fd, nl as [*]const void, nl.len);
        libc.abort();
    }
    $unreachable();
}

func assert(cond: bool, msg: str) {
    if (!cond) {
        debug_panic(msg);
    }
}
