package zeta::time::libc_time;

public struct Timespec {
    tv_sec: i64,
    tv_nsec: i64,
}

public unsafe extern "C" func clock_gettime(
    clock_id: i32,
    tp: [*]mut Timespec
): i32;

public unsafe extern "C" func nanosleep(
    req: [*]const Timespec,
    rem: [*]mut Timespec
): i32;

public unsafe extern "C" func clock_nanosleep(
    clock_id: i32,
    flags: i32,
    request: [*]const Timespec,
    remain: [*]mut Timespec
): i32;


// Linux/POSIX clock IDs.

public const CLOCK_REALTIME: i32 = 0;
public const CLOCK_MONOTONIC: i32 = 1;

// clock_nanosleep flags.

public const TIMER_ABSTIME: i32 = 1;
public const TIMER_RELATIVE: i32 = 0;
