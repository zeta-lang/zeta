package zeta::time::process;

import zeta::time::duration.Duration;
import zeta::time::libc_time.Timespec;
import zeta::time::libc_time;
import zeta::debug;

public func sleep(duration: Duration): void {
    if (duration.is_negative() || duration.is_zero()) {
        return;
    }

    let request: Timespec = Timespec.new(duration.total_seconds(), duration.nanoseconds() as i64);

    let mut remaining: Timespec = Timespec.new(0, 0);

    // Relative CLOCK_MONOTONIC sleep.
    let result: i32 = libc_time.clock_nanosleep(
        libc_time.CLOCK_MONOTONIC,
        libc_time.TIMER_RELATIVE,
        &request,
        &mut remaining
    );

    if (result != 0) {
        debug.debug_panic("clock_nanosleep failed");
    }
}
