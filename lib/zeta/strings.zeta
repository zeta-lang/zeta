package zeta::strings;

import zeta::string.String;
import zeta::utils::mallocator.Mallocator;
import zeta::lang::traits.PartialEq;
import zeta::lang::traits.Eq;

import zeta::result.Result;

public struct Utf8Decode {
    value: u32,
    width: usize,
}

struct Chars {
    remaining: str,
}

impl Chars {
    func next(&mut this): ?u32 {
        if (this.remaining.is_empty()) {
            return null;
        }
        match (decode_utf8_first(this.remaining)) {
            case Result.Ok { value } -> {
                this.remaining =
                    this.remaining.get_slice(value.width, this.remaining.len());
                return value.value;
            },
            case Result.Err { error } -> {
                // Invalid sequence: skip one byte, yield U+FFFD.
                this.remaining =
                    this.remaining.get_slice(1, this.remaining.len());
                return 0xFFFD;
            },
        }
    }
}

struct Split {
    remaining: str,
    delimiter: u8,
    finished: bool,
}

impl Split {
    func next(&mut this): ?str {
        if (this.finished) {
            return null;
        }

        let bytes: &[]u8 = this.remaining.as_bytes();

        for (let mut i: usize = 0; i < bytes.len; i += 1) {
            if (bytes[i] == this.delimiter) {
                let part: str = this.remaining.get_slice(0, i);

                if (i + 1 == bytes.len) {
                    this.finished = true;
                }
                else {
                    this.remaining =
                        this.remaining.get_slice(i + 1, bytes.len);
                }

                return part;
            }
        }

        this.finished = true;
        return this.remaining;
    }
}

func decode_utf8_first(s: str): Result<Utf8Decode, bool> {
    let bytes: &[]u8 = s.as_bytes();

    if (bytes.len == 0) {
        return Result.Err { error: false };
    }

    let b0: u8 = bytes[0];

    // ASCII.
    if (b0 < 0x80) {
        return Result.Ok {
            value: Utf8Decode {
                value: b0 as u32,
                width: 1,
            },
        };
    }

    // 2-byte sequence.
    if (b0 >= 0xC2 && b0 <= 0xDF) {
        if (bytes.len < 2) {
            return Result.Err { error: false };
        }

        let b1: u8 = bytes[1];

        if ((b1 & 0xC0) != 0x80) {
            return Result.Err { error: false };
        }

        let value: u32 =
            (((b0 & 0x1F) as u32) << 6) |
            ((b1 & 0x3F) as u32);

        return Result.Ok {
            value: Utf8Decode {
                value,
                width: 2,
            },
        };
    }

    // 3-byte sequence.
    if (b0 >= 0xE0 && b0 <= 0xEF) {
        if (bytes.len < 3) {
            return Result.Err { error: false };
        }

        let b1: u8 = bytes[1];
        let b2: u8 = bytes[2];

        if ((b1 & 0xC0) != 0x80 ||
            (b2 & 0xC0) != 0x80) {
            return Result.Err { error: false };
        }

        // Reject overlong encodings and UTF-16 surrogate range.
        if (b0 == 0xE0 && b1 < 0xA0) {
            return Result.Err { error: false };
        }

        if (b0 == 0xED && b1 >= 0xA0) {
            return Result.Err { error: false };
        }

        let value: u32 =
            (((b0 & 0x0F) as u32) << 12) |
            (((b1 & 0x3F) as u32) << 6) |
            ((b2 & 0x3F) as u32);

        return Result.Ok {
            value: Utf8Decode {
                value,
                width: 3,
            },
        };
    }

    // 4-byte sequence.
    if (b0 >= 0xF0 && b0 <= 0xF4) {
        if (bytes.len < 4) {
            return Result.Err { error: false };
        }

        let b1: u8 = bytes[1];
        let b2: u8 = bytes[2];
        let b3: u8 = bytes[3];

        if ((b1 & 0xC0) != 0x80 ||
            (b2 & 0xC0) != 0x80 ||
            (b3 & 0xC0) != 0x80) {
            return Result.Err { error: false };
        }

        if (b0 == 0xF0 && b1 < 0x90) {
            return Result.Err { error: false };
        }

        if (b0 == 0xF4 && b1 >= 0x90) {
            return Result.Err { error: false };
        }

        let value: u32 =
            (((b0 & 0x07) as u32) << 18) |
            (((b1 & 0x3F) as u32) << 12) |
            (((b2 & 0x3F) as u32) << 6) |
            ((b3 & 0x3F) as u32);

        return Result.Ok {
            value: Utf8Decode {
                value,
                width: 4,
            },
        };
    }

    return Result.Err { error: false };
}

func ascii_lower(byte: u8): u8 {
    if (byte >= ('A' as u8) && byte <= ('Z' as u8)) {
        return byte + 32;
    }

    return byte;
}

func ascii_upper(byte: u8): u8 {
    if (byte >= ('a' as u8) && byte <= ('z' as u8)) {
        return byte - 32;
    }
    return byte;
}

impl str {
    func as_bytes(&this): &[]u8 {
        unsafe {
            let data_ptr: [*]const u8 = *($reinterpret<[*]const [*]const u8>(this));
            return data_ptr[0..<this.len()];
        }
    }

    func from_utf8(bytes: &[]u8): Result<str, Utf8ConversionError> {
        let mut offset: usize = 0;

        while (offset < bytes.len) {
            let remainder: str = unsafe {
                str.from_utf8_unchecked(bytes[offset..<bytes.len])
            };

            match (decode_utf8_first(remainder)) {
                case Result.Ok { value } -> {
                    offset += value.width;
                },
                case Result.Err { error } -> {
                    return Result.Err {
                        error: Utf8ConversionError {},
                    };
                },
            }
        }

        unsafe {
            return Result.Ok {
                value: str.from_utf8_unchecked(bytes),
            };
        }
    }

    unsafe func from_utf8_unchecked(bytes: &[]u8): str {
        return $reinterpret<str>(bytes);   // identical {ptr,len} layout
    }

    func as_bytes(&this): &[]u8 {
        unsafe {
            let data_ptr: [*]const u8 = *($reinterpret<[*]const [*]const u8>(this));
            return data_ptr[0..<this.len()];
        }
    }

    func get(&this, index: usize): ?u8 {
        if (index >= this.len()) {
            return null;
        }

        let bytes: &[]u8 = this.as_bytes();
        return bytes[index];
    }

    func get_slice(&this, start: usize, end: usize): str {
        return this[start..<end];
    }

    func is_empty(&this): bool {
        return this.len() == 0;
    }

    func len(&this): usize {
        unsafe {
            let words: [*]const usize = $reinterpret<[*]const usize>(this);
            return words[1];
        }
    }

    func trim_start(&this): str {
        let bytes: &[]u8 = this.as_bytes();

        let mut start: usize = 0;

        while (start < bytes.len) {
            let b: u8 = bytes[start];

            if (b != (' ' as u8) &&
                b != ('\t' as u8) &&
                b != ('\n' as u8) &&
                b != ('\r' as u8)) {
                break;
            }

            start += 1;
        }

        return this[start..<bytes.len];
    }

    func trim_end(&this): str {
        let bytes: &[]u8 = this.as_bytes();

        let mut end: usize = bytes.len;

        while (end > 0) {
            let b: u8 = bytes[end - 1];

            if (b != (' ' as u8) &&
                b != ('\t' as u8) &&
                b != ('\n' as u8) &&
                b != ('\r' as u8)) {
                break;
            }

            end -= 1;
        }

        return this[0..<end];
    }

    func trim(&this): str {
        return this.trim_start().trim_end();
    }

    func starts_with(&this, prefix: str): bool {
        let a: &[]u8 = this.as_bytes();
        let b: &[]u8 = prefix.as_bytes();

        if (b.len > a.len) {
            return false;
        }

        for (let mut i: usize = 0; i < b.len; i += 1) {
            if (a[i] != b[i]) {
                return false;
            }
        }

        return true;
    }

    func ends_with(&this, suffix: str): bool {
        let a: &[]u8 = this.as_bytes();
        let b: &[]u8 = suffix.as_bytes();

        if (b.len > a.len) {
            return false;
        }

        let start: usize = a.len - b.len;

        for (let mut i: usize = 0; i < b.len; i += 1) {
            if (a[start + i] != b[i]) {
                return false;
            }
        }

        return true;
    }

    func contains(&this, needle: str): bool {
        return this.find(needle) != null;
    }

    func find(&this, needle: str): ?usize {
        let a: &[]u8 = this.as_bytes();
        let b: &[]u8 = needle.as_bytes();

        if (b.len == 0) {
            return 0;
        }

        if (b.len > a.len) {
            return null;
        }

        let last: usize = a.len - b.len;

        for (let mut i: usize = 0; i <= last; i += 1) {
            let mut matched: bool = true;

            for (let mut j: usize = 0; j < b.len; j += 1) {
                if (a[i + j] != b[j]) {
                    matched = false;
                    break;
                }
            }

            if (matched) {
                return i;
            }
        }

        return null;
    }

    func eq_ignore_ascii_case(&this, other: str): bool {
        let a: &[]u8 = this.as_bytes();
        let b: &[]u8 = other.as_bytes();

        if (a.len != b.len) {
            return false;
        }

        for (let mut i: usize = 0; i < a.len; i += 1) {
            if (ascii_lower(a[i]) != ascii_lower(b[i])) {
                return false;
            }
        }

        return true;
    }

    func split(&this, delimiter: u8): Split {
        return Split {
            remaining: this,
            delimiter,
            finished: false,
        };
    }

    func is_ascii(&this): bool {
        let bytes: &[]u8 = this.as_bytes();
        for (let mut i: usize = 0; i < bytes.len; i += 1) {
            if (bytes[i] >= 0x80) { return false; }
        }
        return true;
    }

    func rfind(&this, needle: str): ?usize {
        let a: &[]u8 = this.as_bytes();
        let b: &[]u8 = needle.as_bytes();

        if (b.len == 0) { return a.len; }
        if (b.len > a.len) { return null; }

        let mut i: usize = a.len - b.len + 1;
        while (i > 0) {
            i -= 1;
            let mut matched: bool = true;
            for (let mut j: usize = 0; j < b.len; j += 1) {
                if (a[i + j] != b[j]) {
                    matched = false;
                    break;
                }
            }
            if (matched) { return i; }
        }
        return null;
    }

    func strip_prefix(&this, prefix: str): ?str {
        if (!this.starts_with(prefix)) { return null; }
        return this.get_slice(prefix.len(), this.len());
    }

    func strip_suffix(&this, suffix: str): ?str {
        if (!this.ends_with(suffix)) { return null; }
        return this.get_slice(0, this.len() - suffix.len());
    }

    func chars(&this): Chars {
        return Chars { remaining: *this };
    }

    func char_count(&this): usize {
        let mut it: Chars = this.chars();
        let mut count: usize = 0;
        while (it.next() != null) {
            count += 1;
        }
        return count;
    }

    func to_ascii_lowercase(&this): String<Mallocator> {
        let bytes: &[]u8 = this.as_bytes();
        let mut out: String<Mallocator> = String.with_capacity(bytes.len);
        for (let mut i: usize = 0; i < bytes.len; i += 1) {
            out.push_byte(ascii_lower(bytes[i]));
        }
        return out;
    }

    func to_ascii_uppercase(&this): String<Mallocator> {
        let bytes: &[]u8 = this.as_bytes();
        let mut out: String<Mallocator> = String.with_capacity(bytes.len);
        for (let mut i: usize = 0; i < bytes.len; i += 1) {
            out.push_byte(ascii_upper(bytes[i]));
        }
        return out;
    }
}

struct Utf8ConversionError {}

impl str by PartialEq {
    func eq(&this, other: &str): bool {
        let a: &[]u8 = this.as_bytes();
        let b: &[]u8 = other.as_bytes();

        if (a.len != b.len) {
            return false;
        }

        for (let mut i: usize = 0; i < a.len; i += 1) {
            if (a[i] != b[i]) {
                return false;
            }
        }

        return true;
    }

    func ne(&this, other: &str): bool {
        return !this.eq(other);
    }
}

impl str by Eq {
}
