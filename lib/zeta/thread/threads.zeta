package zeta::thread::threads;

import zeta::alloc::allocator.Allocator;
import zeta::utils::mallocator.Mallocator;
import zeta::libc.Pthread;
import zeta::libc;
import zeta::debug;
import zeta::io;

struct ThreadCtxHeader {
    invoke: &func(arg: [*]mut void): void,
}

// F-dependent. Only ever touched inside invoke_impl<F,R,A>.
struct ThreadCtx<F, R, A: Allocator> {
    header: ThreadCtxHeader,   // MUST be first field
    func_: F,
    slot: [*]mut ResultSlot<R, A>,
    alloc: A,                 // needed to reclaim *this* block
}

struct ResultSlot<R, A: Allocator> {
    manual result: ?R,
    alloc: A,
}

struct JoinHandleInner<R, A: Allocator> {
    tid: Pthread,
    slot: ^ResultSlot<R, A>,
}

struct JoinHandle<R, A: Allocator> {
    manual inner: JoinHandleInner<R, A>,
}

extern "C" func thread_entry(arg: [*]mut void): [*]mut void {
    let hdr: [*]mut ThreadCtxHeader = arg as [*]mut ThreadCtxHeader;

    unsafe { (*hdr).invoke(arg); }

    return null;
}

func invoke_impl<F: func(): R, R, A: Allocator>(arg: [*]mut void): void {
    let raw: [*]mut ThreadCtx<F, R, A> = arg as [*]mut ThreadCtx<F, R, A>;

    let alloc: A = unsafe { (*raw).alloc };

    let slot: [*]mut ResultSlot<R, A> = unsafe { (*raw).slot };

    let result: R = unsafe { (*raw).func_() };

    unsafe { (*slot).result = result; }

    let owned: ^ThreadCtx<F, R, A> = unsafe { $own(raw, alloc) };
}

func reclaim_ctx<F: func(): R, R>(raw: [*]mut void, alloc: Mallocator): void {
    let back: ^ThreadCtx<F, R, Mallocator> =
        unsafe { $own(raw as [*]mut ThreadCtx<F, R, Mallocator>, alloc) };
}

func spawn<F: func(): R, R>(f: F): JoinHandle<R, Mallocator> {
    let alloc: Mallocator = Mallocator {};

    let slot: ^ResultSlot<R, Mallocator> =
        alloc.new(ResultSlot<R, Mallocator> { result: null, alloc });

    let ctx: ^ThreadCtx<F, R, Mallocator> = alloc.new(ThreadCtx<F, R, Mallocator> {
        header: ThreadCtxHeader {
            invoke: invoke_impl<F, R, Mallocator>,
        },
        func_: f,
        slot: slot as [*]mut ResultSlot<R, Mallocator>,
        alloc,
    });

    let mut tid: Pthread = uninit;
    let raw_ctx: [*]mut void = unsafe { $leak(ctx) } as [*]mut void;

    let ret: i32 = unsafe {
        libc.pthread_create(&mut tid, null, thread_entry as [*]const void, raw_ctx)
    };

    if (ret != 0) {
        // the thread never ran, so we still own the block
        let back: ^ThreadCtx<F, R, Mallocator> =
            unsafe {
                $own(
                    raw_ctx as [*]mut ThreadCtx<F, R, Mallocator>,
                    alloc
                )
            };

        debug.debug_panic("pthread_create failed");
    }

    return JoinHandle<R, Mallocator> {
        inner: JoinHandleInner<R, Mallocator> {
            tid,
            slot,
        },
    };
}

impl<R, A: Allocator> JoinHandle<R, A> {
    func join(mut this): Result<R, i32> {
        let mut retval: [*]mut void = uninit;
        let ret: i32 = unsafe { libc.pthread_join(this.inner.tid, &mut retval) };

        if (ret != 0) {
            return Result.Err { error: ret };
        }

        let result: ?R = unsafe { (*this.inner.slot).result };
        if (result == null) {
            $unreachable();
        }

        unsafe { $drop_in_place(&mut this.inner); }

        $mem_forget(this);

        return Result.Ok { value: result };
    }
}

// TODO: this is UB and causes a segfault, yet to know why
// impl<R, A: Allocator> JoinHandle<R, A> by Drop {
//     func drop(mut this) {
//         unsafe { libc.pthread_detach(this.inner.tid) }
//     }
// }

impl<R, A: Allocator> JoinHandleInner<R, A> by Drop {
    func drop(mut this) {
        unsafe { libc.pthread_detach(this.tid) }
    }
}
