package zeta::io_error;

import zeta::libc;

public enum IOError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    Interrupted,
    WouldBlock,
    InvalidInput,
    UnexpectedEof,
    WriteZero,
    Other { err_no: i32 },
}

public const ENOENT: i32 = 2;
public const EINTR:  i32 = 4;
public const EAGAIN: i32 = 11;
public const EACCES: i32 = 13;
public const EEXIST: i32 = 17;
public const EINVAL: i32 = 22;

impl IOError {
    public func from_errno(): IOError {
        let code: i32 = unsafe { *libc.__errno_location() };
        return match (code) {
            case 2 -> IOError.NotFound,
            case 13 -> IOError.PermissionDenied,
            case 17 -> IOError.AlreadyExists,
            case 4  -> IOError.Interrupted,
            case 11 -> IOError.WouldBlock,
            case 22 -> IOError.InvalidInput,
            case _  -> IOError.Other { err_no: code },
        };
    }
}
