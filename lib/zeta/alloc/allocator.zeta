package zeta::alloc::allocator;

public interface Allocator {
    public func alloc<T>(&this): ^T;

    public func calloc<T>(&this, count: usize): ^[]T;

    public func realloc<T>(
        &this,
        value: ^[]T,
        new_len: usize
    ): ^[]T;

    public func new<T>(&this, value: T): ^T;

    public func free<T>(&this, value: ^T);

    public func free_slice<T>(&this, value: ^[]T);

    public unsafe func alloc_raw(
        &this,
        size: usize,
        align: usize
    ): [*]mut u8;

    public unsafe func calloc_raw(
        &this,
        count: usize,
        size: usize,
        align: usize
    ): [*]mut u8;

    public unsafe func realloc_raw(
        &this,
        ptr: [*]mut u8,
        old_size: usize,
        new_size: usize,
        align: usize
    ): [*]mut u8;

    public unsafe func free_raw(
        &this,
        ptr: [*]mut u8,
        size: usize,
        align: usize
    );
}

public interface RawAllocator {
    public unsafe func alloc_raw(
        &this,
        size: usize,
        align: usize
    ): [*]mut u8;

    public unsafe func calloc_raw(
        &this,
        count: usize,
        size: usize,
        align: usize
    ): [*]mut u8;

    public unsafe func realloc_raw(
        &this,
        ptr: [*]mut u8,
        old_size: usize,
        new_size: usize,
        align: usize
    ): [*]mut u8;

    public unsafe func free_raw(
        &this,
        ptr: [*]mut u8,
        size: usize,
        align: usize
    );
}
