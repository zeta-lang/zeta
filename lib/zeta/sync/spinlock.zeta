package zeta::sync::spinlock;

import zeta::sync::atomic.Atomic;
import zeta::sync::atomic.Ordering;

struct SpinLock {
    state: Atomic<u32>,
}

impl SpinLock {
    func new(): SpinLock {
        return SpinLock {
            state: Atomic.new(0),
        };
    }

    func lock(&mut this) {
        while (true) {
            if (this.state.compare_exchange(
                0,
                1,
                Ordering.Acquire,
                Ordering.Relaxed,
            )) {
                return;
            }

            while (this.state.load(Ordering.Relaxed) != 0) {
                $cpu_relax();
            }
        }
    }

    func try_lock(&mut this): bool {
        return this.state.compare_exchange(
            0,
            1,
            Ordering.Acquire,
            Ordering.Relaxed,
        );
    }

    func unlock(&mut this) {
        this.state.store(
            0,
            Ordering.Release,
        );
    }
}
