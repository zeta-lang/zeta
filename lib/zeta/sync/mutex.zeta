package zeta::sync::mutex;

import zeta::libc;
import zeta::libc.PthreadMutex;

public struct Mutex<T> {
    raw: libc.PthreadMutex,
    value: T,
}

// Locking hands `T` to whichever thread gets the lock, so `T` must be `Send`.
unsafe impl<T: Send> Mutex<T> by Send {}
unsafe impl<T: Send> Mutex<T> by Sync {}

public struct MutexGuard<T> {
    mutex: &alias Mutex<T>,
    ptr: [*]mut T,
}

impl<T> Mutex<T> {
    public func new(value: T): Mutex<T> {
        let mut m: Mutex<T> = Mutex<T> {
            raw: libc.PthreadMutex { opaque: undefined },
            value: value,
        };
        if (libc.pthread_mutex_init(&mut m.raw as [*]mut libc.PthreadMutex, null) != 0) {
            libc.abort();
        }
        return m;
    }

    public func lock(&alias this): MutexGuard<T> {
        if (libc.pthread_mutex_lock(&alias this.raw as [*]mut libc.PthreadMutex) != 0) {
            libc.abort();
        }
        // only formed once the lock is held
        let ptr: [*]mut T = &alias this.value as [*]mut T;
        return MutexGuard<T> { mutex: this, ptr: ptr };
    }

    /// Returns null if the lock is already held.
    public func try_lock(&alias this): ?MutexGuard<T> {
        if (libc.pthread_mutex_trylock(&alias this.raw as [*]mut libc.PthreadMutex) == 0) {
            let ptr: [*]mut T = &alias this.value as [*]mut T;
            return MutexGuard<T> { mutex: this, ptr: ptr };
        }
        return null;
    }
}

impl<T> Mutex<T> by Drop {
    func drop(mut this) {
        libc.pthread_mutex_destroy(&mut this.raw as [*]mut libc.PthreadMutex);
    }
}

impl<T> MutexGuard<T> {
    public func get(&this): &T {
        return unsafe { &(*this.ptr) };
    }

    public func get_mut(&mut this): &mut T {
        return unsafe { &mut (*this.ptr) };
    }

    public func set(&mut this, value: T) {
        *this.get_mut() = value;
    }
}

impl<T> MutexGuard<T> by Drop {
    func drop(mut this) {
        if (libc.pthread_mutex_unlock(&alias this.mutex.raw as [*]mut libc.PthreadMutex) != 0) {
            libc.abort();
        }
    }
}
