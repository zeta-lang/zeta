package zeta::parse;

import zeta::string.String;
import zeta::utils::mallocator.Mallocator;

public enum ParseErrorKind {
    EmptyInput,
    InvalidDigit,
    InvalidSign,
    InvalidBoolean,
    InvalidCharacter,
    InvalidUtf8,
    Overflow,
    InvalidFormat,
    UnexpectedEnd,
    UnexpectedCharacter,
    TrailingCharacters,
}

public struct ParseError {
    kind: ParseErrorKind,
    position: usize,
}

public interface Parse {
    // String -> type.
    func parse(s: str): Result<This, ParseError>;
}

public interface ToString {
    // Type -> String.
    func to_string(&this): String<Mallocator>;
}

func digit_value(byte: u8): ?u8 {
    if (byte >= ('0' as u8) && byte <= ('9' as u8)) {
        return byte - ('0' as u8);
    }

    if (byte >= ('a' as u8) && byte <= ('f' as u8)) {
        return byte - ('a' as u8) + 10;
    }

    if (byte >= ('A' as u8) && byte <= ('F' as u8)) {
        return byte - ('A' as u8) + 10;
    }

    return null;
}

func parse_u64_radix(s: str, radix: u8): Result<u64, ParseError> {
    let input: &[]u8 = s.trim().as_bytes();

    if (input.len == 0) {
        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.EmptyInput,
                position: 0,
            },
        };
    }

    let mut start: usize = 0;

    // Optional 0x / 0o / 0b prefixes.
    if (input.len >= 2 && input[0] == ('0' as u8)) {
        if (radix == 16 &&
            (input[1] == ('x' as u8) || input[1] == ('X' as u8))) {
            start = 2;
        }
        else if (radix == 8 &&
            (input[1] == ('o' as u8) || input[1] == ('O' as u8))) {
            start = 2;
        }
        else if (radix == 2 &&
            (input[1] == ('b' as u8) || input[1] == ('B' as u8))) {
            start = 2;
        }
    }

    if (start == input.len) {
        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.InvalidDigit,
                position: start,
            },
        };
    }

    let mut value: u64 = 0;
    let mut i: usize = start;

    while (i < input.len) {
        let digit: u8 = match (digit_value(input[i])) {
            case real -> real,
            case null -> {
                return Result.Err {
                    error: ParseError {
                        kind: ParseErrorKind.InvalidDigit,
                        position: i,
                    },
                };
            },
        };

        if (digit >= radix) {
            return Result.Err {
                error: ParseError {
                    kind: ParseErrorKind.InvalidDigit,
                    position: i,
                },
            };
        }

        // UINT64_MAX = 0xffffffffffffffff
        let max: u64 = 0xffffffffffffffff;

        if (value > (max - (digit as u64)) / (radix as u64)) {
            return Result.Err {
                error: ParseError {
                    kind: ParseErrorKind.Overflow,
                    position: i,
                },
            };
        }

        value = value * (radix as u64) + digit as u64;
        i += 1;
    }

    return Result.Ok { value };
}

func parse_u64(s: str): Result<u64, ParseError> {
    let mut input: str = s.trim();

    let bytes: &[]u8 = input.as_bytes();

    if (bytes.len == 0) {
        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.EmptyInput,
                position: 0,
            },
        };
    }

    if (bytes[0] == ('+' as u8)) {
        input = input.get_slice(1, bytes.len);
    }
    else if (bytes[0] == ('-' as u8)) {
        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.InvalidSign,
                position: 0,
            },
        };
    }

    let trimmed_bytes: &[]u8 = input.as_bytes();

    let radix: u8 =
        if (trimmed_bytes.len >= 2 &&
            trimmed_bytes[0] == ('0' as u8) &&
            (trimmed_bytes[1] == ('x' as u8) || trimmed_bytes[1] == ('X' as u8))) {
            16
        }
        else if (trimmed_bytes.len >= 2 &&
            trimmed_bytes[0] == ('0' as u8) &&
            (trimmed_bytes[1] == ('b' as u8) || trimmed_bytes[1] == ('B' as u8))) {
            2
        }
        else if (trimmed_bytes.len >= 2 &&
            trimmed_bytes[0] == ('0' as u8) &&
            (trimmed_bytes[1] == ('o' as u8) || trimmed_bytes[1] == ('O' as u8))) {
            8
        }
        else {
            10
        };

    return parse_u64_radix(input, radix);
}

func parse_i64(s: str): Result<i64, ParseError> {
    let input: str = s.trim();
    let bytes: &[]u8 = input.as_bytes();

    if (bytes.len == 0) {
        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.EmptyInput,
                position: 0,
            },
        };
    }

    let mut negative: bool = false;
    let mut digits: str = input;

    if (bytes[0] == ('-' as u8)) {
        negative = true;
        digits = input.get_slice(1, bytes.len);
    }
    else if (bytes[0] == ('+' as u8)) {
        digits = input.get_slice(1, bytes.len);
    }

    if (digits.as_bytes().len == 0) {
        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.InvalidSign,
                position: 1,
            },
        };
    }

    let magnitude: u64 = match (parse_u64(digits)) {
        case Result.Ok { value } -> value,
        case Result.Err { error } -> return Result.Err { error },
    };

    // Positive i64 max.
    if (!negative) {
        if (magnitude > 0x7fffffffffffffff) {
            return Result.Err {
                error: ParseError {
                    kind: ParseErrorKind.Overflow,
                    position: bytes.len,
                },
            };
        }

        return Result.Ok { value: magnitude as i64 };
    }

    // Absolute value of INT64_MIN.
    if (magnitude > 0x8000000000000000) {
        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.Overflow,
                position: bytes.len,
            },
        };
    }

    if (magnitude == 0x8000000000000000) {
        return Result.Ok { value: -9223372036854775807i64 - 1i64 };
    }

    return Result.Ok { value: -(magnitude as i64) };
}

impl u64 by Parse {
    func parse(s: str): Result<u64, ParseError> {
        return parse_u64(s);
    }
}

impl i64 by Parse {
    func parse(s: str): Result<i64, ParseError> {
        return parse_i64(s);
    }
}

impl u32 by Parse {
    func parse(s: str): Result<u32, ParseError> {
        let value: u64 = match (parse_u64(s)) {
            case Result.Ok { value } -> value,
            case Result.Err { error } -> return Result.Err { error },
        };

        if (value > 0xffffffff) {
            return Result.Err {
                error: ParseError {
                    kind: ParseErrorKind.Overflow,
                    position: s.as_bytes().len,
                },
            };
        }

        return Result.Ok { value: value as u32 };
    }
}

impl i32 by Parse {
    func parse(s: str): Result<i32, ParseError> {
        let value: i64 = match (parse_i64(s)) {
            case Result.Ok { value } -> value,
            case Result.Err { error } -> return Result.Err { error },
        };

        if (value < -2147483648i64 || value > 2147483647i64) {
            return Result.Err {
                error: ParseError {
                    kind: ParseErrorKind.Overflow,
                    position: s.as_bytes().len,
                },
            };
        }

        return Result.Ok { value: value as i32 };
    }
}

impl usize by Parse {
    func parse(s: str): Result<usize, ParseError> {
        let value: u64 = match (parse_u64(s)) {
            case Result.Ok { value } -> value,
            case Result.Err { error } -> return Result.Err { error },
        };

        return Result.Ok { value: value as usize };
    }
}

func parse_f64(s: str): Result<f64, ParseError> {
    let input: str = s.trim();
    let bytes: &[]u8 = input.as_bytes();

    if (bytes.len == 0) {
        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.EmptyInput,
                position: 0,
            },
        };
    }

    let mut i: usize = 0;
    let mut negative: bool = false;

    if (bytes[i] == ('-' as u8)) {
        negative = true;
        i += 1;
    }
    else if (bytes[i] == ('+' as u8)) {
        i += 1;
    }

    let mut value: f64 = 0.0;
    let mut found_digit: bool = false;

    // Integer portion.
    while (i < bytes.len &&
           bytes[i] >= ('0' as u8) &&
           bytes[i] <= ('9' as u8)) {

        value = value * 10.0 + ((bytes[i] - ('0' as u8)) as f64);
        found_digit = true;
        i += 1;
    }

    // Fractional portion.
    if (i < bytes.len && bytes[i] == ('.' as u8)) {
        i += 1;

        let mut scale: f64 = 0.1;

        while (i < bytes.len &&
               bytes[i] >= ('0' as u8) &&
               bytes[i] <= ('9' as u8)) {

            value += ((bytes[i] - ('0' as u8)) as f64) * scale;
            scale *= 0.1;

            found_digit = true;
            i += 1;
        }
    }

    if (!found_digit) {
        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.InvalidFormat,
                position: i,
            },
        };
    }

    // Exponent.
    if (i < bytes.len &&
        (bytes[i] == ('e' as u8) || bytes[i] == ('E' as u8))) {

        i += 1;

        let mut exponent_negative: bool = false;

        if (i < bytes.len && bytes[i] == ('-' as u8)) {
            exponent_negative = true;
            i += 1;
        }
        else if (i < bytes.len && bytes[i] == ('+' as u8)) {
            i += 1;
        }

        if (i >= bytes.len) {
            return Result.Err {
                error: ParseError {
                    kind: ParseErrorKind.UnexpectedEnd,
                    position: i,
                },
            };
        }

        let mut exponent: usize = 0;
        let mut found_exponent_digit: bool = false;

        while (i < bytes.len &&
               bytes[i] >= ('0' as u8) &&
               bytes[i] <= ('9' as u8)) {

            exponent = exponent * 10 +
                       ((bytes[i] - ('0' as u8)) as usize);

            found_exponent_digit = true;
            i += 1;

            // Don't let malformed input turn into a giant loop.
            if (exponent > 400) {
                exponent = 400;
            }
        }

        if (!found_exponent_digit) {
            return Result.Err {
                error: ParseError {
                    kind: ParseErrorKind.InvalidFormat,
                    position: i,
                },
            };
        }

        let mut scale: f64 = 1.0;

        if (exponent_negative) {
            for (let mut j: usize = 0; j < exponent; j += 1) {
                scale *= 0.1;
            }
        }
        else {
            for (let mut j: usize = 0; j < exponent; j += 1) {
                scale *= 10.0;
            }
        }

        value *= scale;
    }

    if (i != bytes.len) {
        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.TrailingCharacters,
                position: i,
            },
        };
    }

    if (negative) {
        value = (-value as f64);
    }

    return Result.Ok { value };
}

impl f64 by Parse {
    func parse(s: str): Result<f64, ParseError> {
        return parse_f64(s);
    }
}

impl f32 by Parse {
    func parse(s: str): Result<f32, ParseError> {
        let value: f64 = match (parse_f64(s)) {
            case Result.Ok { value } -> value,
            case Result.Err { error } -> return Result.Err { error },
        };

        return Result.Ok { value: value as f32 };
    }
}

impl bool by Parse {
    func parse(s: str): Result<bool, ParseError> {
        let input: str = s.trim();

        if (input.eq_ignore_ascii_case("true")) {
            return Result.Ok { value: true };
        }

        if (input.eq_ignore_ascii_case("false")) {
            return Result.Ok { value: false };
        }

        return Result.Err {
            error: ParseError {
                kind: ParseErrorKind.InvalidBoolean,
                position: 0,
            },
        };
    }
}
