package zeta::file;
import zeta::libc;
import zeta::debug;
import zeta::io_error.IOError;
import zeta::result.Result;
import zeta::io_channel.ReadChannel;
import zeta::io_channel.WriteChannel;
import zeta::utils::array_list.ArrayList;

const O_RDONLY: i32 = 0o0;
const O_WRONLY: i32 = 0o1;
const O_RDWR:   i32 = 0o2;
const O_CREAT:  i32 = 0o100;
const O_TRUNC:  i32 = 0o1000;
const O_APPEND: i32 = 0o2000;

const DEFAULT_MODE: i32 = 0o644;

struct CPathBuf {
    buf: [4096]u8,
    len: usize,
}

impl CPathBuf {
    func from_str(path: str): CPathBuf {
        let bytes: &[]u8 = path.as_bytes();
        if (bytes.len >= 4096) {
            debug.debug_panic("path exceeds max length");
        }
        let mut cbuf: CPathBuf = CPathBuf { buf: undefined, len: bytes.len };
        for (let i: usize = 0; i < bytes.len; i += 1) {
            cbuf.buf[i] = bytes[i];
        }
        cbuf.buf[bytes.len] = 0;
        return cbuf;
    }
    unsafe func ptr(&this): [*]const u8 {
        return &this.buf as [*]const u8;
    }
}

struct File {
    fd: i32,
}

impl File {
    unsafe func from_raw_fd(fd: i32): File {
        return File { fd };
    }

    func open(path: str): Result<File, IOError> {
        return File.open_with_flags(path, O_RDONLY, 0);
    }

    func create(path: str): Result<File, IOError> {
        return File.open_with_flags(path, O_WRONLY | O_CREAT | O_TRUNC, DEFAULT_MODE);
    }

    func append(path: str): Result<File, IOError> {
        return File.open_with_flags(path, O_WRONLY | O_CREAT | O_APPEND, DEFAULT_MODE);
    }

    func open_with_flags(path: str, flags: i32, mode: i32): Result<File, IOError> {
        let cpath: CPathBuf = CPathBuf.from_str(path);
        let fd: i32 = unsafe { libc.open(cpath.ptr(), flags, mode) };
        if (fd < 0) {
            return Result.Err { error: IOError.from_errno() };
        }
        return Result.Ok { value: File { fd } };
    }

    func stdin(): File  { return File { fd: 0 }; }
    func stdout(): File { return File { fd: 1 }; }
    func stderr(): File { return File { fd: 2 }; }

    func reader(&this): FileReader {
        return FileReader { fd: this.fd };
    }
    func writer(&this): FileWriter {
        return FileWriter { fd: this.fd };
    }

    func close(mut this): Result<void, IOError> {
        let ret: i32 = unsafe { libc.close(this.fd) };
        if (ret < 0) {
            return Result.Err { error: IOError.from_errno() };
        }
        return Result.Ok { value: void };
    }
}

struct FileReader { fd: i32 }
impl FileReader by ReadChannel {
    unsafe func read_raw(&mut this, buffer: &mut []u8): Result<usize, IOError> {
        let n: isize = libc.read(this.fd, buffer as [*]mut void, buffer.len);
        if (n < 0) {
            return Result.Err { error: IOError.from_errno() };
        }
        return Result.Ok { value: n as usize };
    }

    func read_exact(&mut this, buffer: &[]u8): Result<usize, IOError> {
        let mut filled: usize = 0;
        while (filled < buffer.len) {
            let n: usize = match (unsafe { this.read_raw(buffer[filled..buffer.len]) }) {
                case Result.Ok { value } -> value,
                case Result.Err { error } -> return Result.Err { error },
            };
            if (n == 0) {
                return Result.Err { error: IOError.UnexpectedEof };
            }
            filled += n;
        }
        return Result.Ok { value: filled };
    }

    func skip(&mut this, count: usize): Result<usize, IOError> {
        //let mut remaining: usize = count;
        //let mut chunk: [4096]u8 = undefined;
        //while (remaining > 0) {
        //    let want: usize = if (remaining < 4096) { remaining } else { 4096 };
        //    let n: usize = match (unsafe { this.read_raw(chunk[0..want]) }) {
        //        case Result.Ok { value } -> value,
        //        case Result.Err { error } -> return Result.Err { error },
        //    };
        //    if (n == 0) { break; }
        //    remaining -= n;
        //}
        //return Result.Ok { value: count - remaining };
        return Result.Ok { value: count };
    }

    func read_to_end<A: Allocator>(&mut this, out: &ArrayList<u8, A>): Result<usize, IOError> {
        let mut total: usize = 0;
        let mut chunk: [4096]u8 = undefined;
        while (true) {
            let n: usize = match (unsafe { this.read_raw(&chunk) }) {
                case Result.Ok { value } -> value,
                case Result.Err { error } -> return Result.Err { error },
            };
            if (n == 0) { break; }
            for (let i: usize = 0; i < n; i += 1) {
                out.push(chunk[i]);
            }
            total += n;
        }
        return Result.Ok { value: total };
    }

    func read_line<A: Allocator>(&mut this, out: &String<A>): Result<usize, IOError> {
        let mut total: usize = 0;
        let mut byte: [1]u8 = undefined;
        while (true) {
            let n: usize = match (unsafe { this.read_raw(&mut byte) }) {
                case Result.Ok { value } -> value,
                case Result.Err { error } -> return Result.Err { error },
            };
            if (n == 0) { break; }
            total += 1;
            if (byte[0] == '\n' as u8) { break; }
            out.push_byte(byte[0]);
        }
        return Result.Ok { value: total };
    }
}

struct FileWriter { fd: i32 }
impl FileWriter {
    func write(&mut this, bytes: &[]u8): Result<usize, IOError> {
        unsafe { return this.write_raw(bytes); };
    }

    func write_all(&mut this, bytes: &[]u8): Result<usize, IOError> {
        let mut written: usize = 0;
        while (written < bytes.len) {
            let n: usize = match (unsafe { this.write_raw(bytes[written..bytes.len]) }) {
                case Result.Ok { value } -> value,
                case Result.Err { error } -> return Result.Err { error },
            };
            if (n == 0) {
                return Result.Err { error: IOError.WriteZero };
            }
            written += n;
        }
        return Result.Ok { value: written };
    }

    func writeln(&mut this, s: str): Result<bool, IOError> {
        return match (this.write_all(s.as_bytes())) {
            case Result.Err { error } -> Result.Err { error },
            case Result.Ok { value } -> this.write_all("\n".as_bytes()),
        }
    }

    func flush(&mut this): Result<bool, IOError> {
        return Result.Ok { value: false };
    }
}
impl FileWriter by WriteChannel {
    unsafe func write_raw(&mut this, bytes: &[]u8): Result<usize, IOError> {
        let n: isize = libc.write(this.fd, bytes as [*]const void, bytes.len);
        if (n < 0) {
            return Result.Err { error: IOError.from_errno() };
        }
        return Result.Ok { value: n as usize };
    }
}
