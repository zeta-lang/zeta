package zeta::env;

import zeta::sys::args;
import zeta::libc;
import zeta::io;
import zeta::debug;
import zeta::result.Result;
import zeta::string.String;
import zeta::strings.Utf8ConversionError;
import zeta::utils::mallocator.Mallocator;

/// Iterator over the process arguments. The first one is conventionally
/// the executable path, but don't rely on that for security.
public struct Args {
    front: usize,
    back: usize,   // exclusive
}

public func args(): Args {
    return Args { front: 0, back: args.argc() };
}

func arg_string(i: usize): String<Mallocator> {
    let raw: [*]const u8 = args.argv_at(i);

    match (unsafe { String.from_cstr<Mallocator>(raw) }) {
        case Result.Ok { value } -> {
            return value;
        },
        case Result.Err { error } -> {
            debug.debug_panic("command-line argument was not valid unicode");
        },
    }
}

impl Args {
    func next(&mut this): ?String<Mallocator> {
        if (this.front >= this.back) {
            return null;
        }
        let i: usize = this.front;
        this.front += 1;
        return arg_string(i);
    }

    func next_back(&mut this): ?String<Mallocator> {
        if (this.front >= this.back) {
            return null;
        }
        this.back -= 1;
        return arg_string(this.back);
    }

    func len(&this): usize { return this.back - this.front; }
}

public enum VarError { NotPresent, NotUnicode }

/// Looks up `key`; the pointer on success points into `environ`.
func lookup(key: str): Result<[*]const u8, VarError> {
    let bytes: &[]u8 = key.as_bytes();

    for (let mut i: usize = 0; i < bytes.len; i += 1) {
        if (bytes[i] == ('=' as u8) || bytes[i] == 0) {
            return Result.Err { error: VarError.NotPresent };
        }
    }

    // getenv needs a NUL-terminated name.
    let mut name: String<Mallocator> = String.with_capacity(bytes.len + 1);
    name.push_str(key);
    name.push_byte(0);

    let raw: [*]const u8 = unsafe { libc.getenv(name.as_bytes() as [*]const u8) };
    let addr: usize = unsafe { $reinterpret<usize>(raw) };

    if (addr == 0) {
        return Result.Err { error: VarError.NotPresent };
    }

    return Result.Ok { value: raw };
}

/// Fetches the environment variable `key`, copying the value.
public func var(key: str): Result<String<Mallocator>, VarError> {
    let raw: [*]const u8 = match (lookup(key)) {
        case Result.Ok { value } -> value,
        case Result.Err { error } -> return Result.Err { error },
    };

    match (unsafe { String.from_cstr<Mallocator>(raw) }) {
        case Result.Ok { value } -> {
            return Result.Ok { value };
        },
        case Result.Err { error } -> {
            return Result.Err { error: VarError.NotUnicode };
        },
    }
}

/// Like `var`, but without UTF-8 validation.
/// Returns an owned copy, so it stays valid across `set_var`.
public func var_raw(key: str): ?String<Mallocator> {
    match (lookup(key)) {
        case Result.Ok { value } -> {
            return unsafe { String.from_cstr_unchecked<Mallocator>(value) };
        },
        case Result.Err { error } -> {
            return null;
        },
    }
}
