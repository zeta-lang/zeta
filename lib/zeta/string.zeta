package zeta::string;

import zeta::io_channel.WriteChannel;
import zeta::io_error.IOError;
import zeta::utils::mallocator.Mallocator;
import zeta::alloc::allocator.Allocator;
import zeta::utils::array_list.ArrayList;

struct String<A: Allocator = Mallocator> {
    data: ArrayList<u8, A>,
}
impl<A: Allocator = Mallocator> String<A> {
    func new(): String<Mallocator> {
        let alloc: Mallocator = Mallocator {};
        return String<Mallocator> { data: ArrayList.new_in<u8, Mallocator>(alloc) };
    }
    func from(string: str): String<Mallocator> {
        let alloc: Mallocator = Mallocator {};
        let mut heap_string: String<Mallocator> = String.with_capacity_in<Mallocator>(string.len() + 16, alloc);
        heap_string.push_str(string);
        return heap_string;
    }
    func with_capacity(capacity: usize): String<Mallocator> {
        let alloc: Mallocator = Mallocator {};
        return String<Mallocator> { data: ArrayList.with_capacity_in<u8, Mallocator>(capacity, alloc) };
    }
    func new_in(alloc: A): String<A> {
        return String<A> { data: ArrayList.new_in<u8, A>(alloc) };
    }
    func from_in(string: str, alloc: A): String<A> {
        let mut heap_string: String<A> = String.with_capacity_in<A>(string.len() + 16, alloc);
        heap_string.push_str(string);
        return heap_string;
    }
    func with_capacity_in(capacity: usize, alloc: A): String<A> {
        return String<A> { data: ArrayList.with_capacity_in<u8, A>(capacity, alloc) };
    }
    func push_byte(&mut this, byte: u8) {
        this.data.push(byte);
    }
    func push_str(&mut this, s: str) {
        let bytes: &[]u8 = s.as_bytes();
        for (let i: usize = 0; i < bytes.len; i += 1) {
            this.data.push(bytes[i]);
        }
    }
    func len(&this): usize {
        return this.data.len();
    }
    func as_bytes(&this): &[]u8 {
        return this.data.as_slice();
    }
    func as_str(&this): str {
        // SAFETY: invariant is that only valid UTF-8 is ever pushed via
        // push_str/push_byte-of-ASCII.
        unsafe { return str.from_utf8_unchecked(this.as_bytes()); }
    }

    func write(&mut this, bytes: &[]u8): Result<usize, IOError> {
        unsafe { return this.write_raw(bytes); };
    }

    func write_all(&mut this, bytes: &[]u8): Result<usize, IOError> {
        let mut written: usize = 0;
        while (written < bytes.len) {
            let n: usize = match (unsafe { this.write_raw(bytes[written..<bytes.len]) }) {
                case Result.Ok { value } -> value,
                case Result.Err { error } -> return Result.Err { error },
            };
            if (n == 0) {
                return Result.Err { error: IOError.WriteZero };
            }
            written += n;
        }
        return Result.Ok { value: written };
    }

    func writeln(&mut this, s: str): Result<bool, IOError> {
        return match (this.write_all(s.as_bytes())) {
            case Result.Err { error } -> Result.Err { error },
            case Result.Ok { value } -> this.write_all("\n".as_bytes()),
        }
    }

    func flush(&mut this): Result<bool, IOError> {
        return Result.Ok { value: false };
    }
}

impl<A: Allocator> String<A> by WriteChannel {
    unsafe func write_raw(&mut this, bytes: &[]u8): Result<usize, IOError> {
        for (let i: usize = 0; i < bytes.len; i += 1) {
            this.data.push(bytes[i]);
        }
        return Result.Ok { value: bytes.len };
    }
}
