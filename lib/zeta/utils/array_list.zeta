package zeta::utils::array_list;

import zeta::libc;
import zeta::debug;
import zeta::io;
import zeta::alloc::allocator.Allocator;
import zeta::utils::mallocator.Mallocator;

import zeta::lang::traits.Clone;

public struct ArrayList<T, A: Allocator + Clone = Mallocator> {
    data: ^this.alloc []T,
    alloc: A,
}

struct ArrayListDrain<T, A: Allocator + Clone = Mallocator> {
    data: ArrayList<T, A>,
    index: usize,
}

impl<T, A: Allocator + Clone = Mallocator> ArrayList<T, A> {
    func new(): ArrayList<T, Mallocator> {
        let alloc: Mallocator = Mallocator {};
        return ArrayList<T, Mallocator> {
            data: alloc.calloc<T>(16),
            alloc,
        };
    }

    func with_capacity(capacity: usize): ArrayList<T, Mallocator> {
        let alloc: Mallocator = Mallocator {};
        return ArrayList<T, Mallocator> {
            data: alloc.calloc<T>(capacity),
            alloc,
        };
    }

    func new_in(alloc: A): ArrayList<T, A> {
        return ArrayList<T, A> {
            data: alloc.calloc<T>(16),
            alloc,
        };
    }

    func with_capacity_in(capacity: usize, alloc: A): ArrayList<T, A> {
        return ArrayList<T, A> {
            data: alloc.calloc<T>(capacity),
            alloc,
        };
    }

    func len(&this): usize {
        return this.data.len;
    }

    func cap(&this): usize {
        return this.data.cap;
    }

    func is_empty(&this): bool {
        return this.data.len == 0;
    }

    func push(&mut this, value: T) {
        this.reserve(1);

        unsafe {
            this.data.write_uninit(this.data.len, value);
            this.data.len += 1;
        }
    }

    func pop(&mut this): ?T {
        if (this.data.len == 0) {
            return null;
        }

        return unsafe {
            this.data.len -= 1;
            let ptr: [*]mut T = this.data as [*]mut T;
            ptr[this.data.len]
        };
    }

    func get(&this, index: usize): &T {
        return &this.data[index];
    }

    func get_mut(&mut this, index: usize): &mut T {
        return &mut this.data[index];
    }

    func try_get(&this, index: usize): ?&T {
        return if (index >= this.data.len) {
            null
        } else {
            &this.data[index]
        };
    }

    func try_get_mut(&mut this, index: usize): ?&mut T {
        return if (index >= this.data.len) {
            null
        } else {
            &mut this.data[index]
        };
    }

    unsafe func get_unchecked(&this, index: usize): &T {
        let ptr: *const T = this.data as *const T;
        unsafe { return &ptr[index] };
    }

    unsafe func get_unchecked_mut(&mut this, index: usize): &mut T {
        let ptr: *mut T = this.data as *mut T;
        unsafe { return &mut ptr[index] };
    }

    func reserve(&mut this, additional: usize) {
        let required: usize = this.data.len + additional;

        if (required <= this.data.cap) {
            return;
        }

        let mut new_cap: usize =
            if (this.data.cap == 0) {
                16
            } else {
                this.data.cap
            };

        while (new_cap < required) {
            new_cap *= 2;
        }

        unsafe {
            this.data = this.alloc.realloc(this.data, new_cap);
        }
    }

    func insert(&mut this, index: usize, value: T) {
        if (index > this.data.len) {
            debug.debug_panic("ArrayList::insert index out of bounds");
        }

        this.reserve(1);

        unsafe {
            let ptr: [*]mut T = this.data as [*]mut T;

            let mut i: usize = this.data.len;
            while (i > index) {
                ptr[i] = ptr[i - 1];
                i -= 1;
            }

            this.data.write_uninit(index, value);
            this.data.len += 1;
        }
    }

    func contains(&this, value: &T): bool {
        let mut i: usize = 0;

        while (i < this.data.len) {
            if (this.get(i) == value) {
                return true;
            }

            i += 1;
        }

        return false;
    }

    func remove(&mut this, index: usize): T {
        if (index >= this.data.len) {
            debug.debug_panic("ArrayList::remove index out of bounds");
        }

        unsafe {
            let ptr: [*]mut T = this.data as [*]mut T;
            let value: T = ptr[index];

            let mut i: usize = index;
            while (i + 1 < this.data.len) {
                ptr[i] = ptr[i + 1];
                i += 1;
            }

            this.data.len -= 1;
            return value;
        }
    }

    func swap_remove(&mut this, index: usize): T {
        if (index >= this.data.len) {
            debug.debug_panic("ArrayList::swap_remove index out of bounds");
        }

        unsafe {
            let ptr: [*]mut T = this.data as [*]mut T;

            this.data.len -= 1;

            if (index == this.data.len) {
                return ptr[index];
            }

            let value: T = ptr[index];
            ptr[index] = ptr[this.data.len];

            return value;
        }
    }

    func drain(&mut this): ArrayListDrain<T, A> {
        let mut drained: ArrayList<T, A> =
            ArrayList.with_capacity_in<T, A>(this.data.len, this.alloc.clone());

        let mut i: usize = 0;
        while (i < this.data.len) {
            drained.push(this.pop());
            i += 1;
        }

        return ArrayListDrain<T, A> {
            data: drained,
            index: 0,
        };
    }

    func as_slice(&this): &[]T {
        return this.data[0..<this.data.len];
    }

    func clear(&mut this) {
        let ptr: [*]mut T = this.data as [*]mut T;

        while (this.data.len > 0) {
            unsafe {
                this.data.len -= 1;


                let slot: &mut T = &mut ptr[this.data.len];

                $drop_in_place(slot);
            }
        }
    }
}

impl<T, A: Allocator> ArrayListDrain<T, A> {
    func next(&mut this): ?T {
        if (this.index >= this.data.len()) {
            return null;
        }

        let value: T = this.data.pop();
        this.index += 1;

        return value;
    }

    func len(&this): usize {
        if (this.index >= this.data.len()) {
            return 0;
        }

        return this.data.len() - this.index;
    }
}
