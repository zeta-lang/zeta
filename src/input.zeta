    let status14: i64 = test_scope_joins_unjoined();
    if (status14 != 0) { return status14; }

    io.stdout().writeln("");
    io.stdout().writeln("=== All thread tests passed ===");

    return 0;
}

func probe<F: func(): i64>(f: F): i64 {
    return $sizeof<F>() as i64;
}

func test_env_sizeof(): i64 {
    io.stdout().writeln("");
    io.stdout().writeln("=== test_env_sizeof ===");

    let v: i64 = 7;
    if (probe(move func() { return v; }) != 8) {
        io.stdout().writeln("[FAIL] env sizeof != 8");
        return 1;
    } else {
        io.stdout().writeln("[PASS] env sizeof == 8");
    }
    return 0;
}

func test_duration_construction(): i64 {
    io.stdout().writeln("=== Running: test_duration_construction ===");

    let zero: Duration = Duration.zero();

    if (!zero.is_zero()) {
        io.stdout().writeln("[FAIL] zero() is not zero");
        return 1;
    }

    let seconds: Duration =
        Duration.from_seconds(42);

    if (seconds.total_nanoseconds() != 42_000_000_000) {
        io.stdout().writeln("[FAIL] from_seconds() produced wrong value");
        return 2;
    }

    let milliseconds: Duration =
        Duration.from_milliseconds(2500);

    if (milliseconds.total_nanoseconds() != 2_500_000_000) {
        io.stdout().writeln("[FAIL] from_milliseconds() produced wrong value");
        return 3;
    }

    let microseconds: Duration =
        Duration.from_microseconds(1234567);

    if (microseconds.total_nanoseconds() != 1_234_567_000) {
        io.stdout().writeln("[FAIL] from_microseconds() produced wrong value");
        return 4;
    }

    let nanoseconds: Duration =
        Duration.from_nanoseconds(987654321);

    if (nanoseconds.total_nanoseconds() != 987654321) {
        io.stdout().writeln("[FAIL] from_nanoseconds() produced wrong value");
        return 5;
    }

    io.stdout().writeln("[PASS] Duration construction");

    return 0;
}


func test_duration_normalization(): i64 {
    io.stdout().writeln("=== Running: test_duration_normalization ===");

    let negative_half_second: Duration =
        Duration.from_nanoseconds(-500_000_000);

    if (!negative_half_second.is_negative()) {
        io.stdout().writeln("[FAIL] negative subsecond duration not negative");
        return 1;
    }

    if (negative_half_second.total_nanoseconds() != -500_000_000) {
        io.stdout().writeln("[FAIL] negative subsecond normalization failed");
        return 2;
    }

    let negative_one_ns: Duration =
        Duration.from_nanoseconds(-1);

    if (!negative_one_ns.is_negative()) {
        io.stdout().writeln("[FAIL] -1ns not recognized as negative");
        return 3;
    }

    if (negative_one_ns.total_nanoseconds() != -1) {
        io.stdout().writeln("[FAIL] -1ns normalization failed");
        return 4;
    }

    io.stdout().writeln("[PASS] Duration normalization");

    return 0;
}


func test_duration_arithmetic(): i64 {
    io.stdout().writeln("=== Running: test_duration_arithmetic ===");

    let a: Duration =
        Duration.from_milliseconds(1500);

    let b: Duration =
        Duration.from_milliseconds(750);

    let sum: Duration =
        a.add(b);

    if (sum.total_nanoseconds() != 2_250_000_000) {
        io.stdout().writeln("[FAIL] Duration.add() produced wrong value");
        return 1;
    }

    let difference: Duration =
        a.subtract(b);

    if (difference.total_nanoseconds() != 750_000_000) {
        io.stdout().writeln("[FAIL] Duration.subtract() produced wrong value");
        return 2;
    }

    let negative: Duration =
        a.negate();

    if (!negative.is_negative()) {
        io.stdout().writeln("[FAIL] Duration.negate() did not produce negative duration");
        return 3;
    }

    if (negative.total_nanoseconds() != -1_500_000_000) {
        io.stdout().writeln("[FAIL] Duration.negate() produced wrong value");
        return 4;
    }

    let restored: Duration =
        negative.negate();

    if (restored.total_nanoseconds() != 1_500_000_000) {
        io.stdout().writeln("[FAIL] double negation failed");
        return 5;
    }

    io.stdout().writeln("[PASS] Duration arithmetic");

    return 0;
}


func test_datetime_parse_valid(): i64 {
    io.stdout().writeln("=== Running: test_datetime_parse_valid ===");

    let result:
        Result<DateTime, ParseError> =
        DateTime.parse(
            "2024-02-29T23:59:59.123456789Z"
        );

    match (result) {
        case Result.Err { error } -> {
            io.stdout().writeln("[FAIL] valid leap-day DateTime was rejected");
            return 1;
        },

        case Result.Ok { value } -> {
            // 2024-02-29 23:59:59 UTC.
            if (value.to_seconds() != 1709251199) {
                io.stdout().writeln("[FAIL] parsed DateTime has wrong Unix timestamp");
                return 2;
            }
        },
    }

    io.stdout().writeln("[PASS] valid DateTime parsing");

    return 0;
}


func test_datetime_parse_invalid(): i64 {
    io.stdout().writeln("=== Running: test_datetime_parse_invalid ===");

    let invalid_leap:
        Result<DateTime, ParseError> =
        DateTime.parse(
            "2023-02-29T12:00:00Z"
        );

    match (invalid_leap) {
        case Result.Ok { value } -> {
            io.stdout().writeln("[FAIL] invalid leap day was accepted");
            return 1;
        },

        case Result.Err { error } -> {
            io.stdout().writeln("[PASS] invalid leap day rejected");
        },
    }

    let invalid_fraction:
        Result<DateTime, ParseError> =
        DateTime.parse(
            "2024-01-01T00:00:00.1234567890Z"
        );

    match (invalid_fraction) {
        case Result.Ok { value } -> {
            io.stdout().writeln("[FAIL] >9 fractional digits were accepted");
            return 2;
        },

        case Result.Err { error } -> {
            io.stdout().writeln("[PASS] excessive fractional precision rejected");
        },
    }

    let missing_zone:
        Result<DateTime, ParseError> =
        DateTime.parse(
            "2024-01-01T00:00:00"
        );

    match (missing_zone) {
        case Result.Ok { value } -> {
            io.stdout().writeln("[FAIL] DateTime without timezone was accepted");
            return 3;
        },

        case Result.Err { error } -> {
            io.stdout().writeln("[PASS] missing timezone rejected");
        },
    }

    return 0;
}


func test_datetime_offset_equivalence(): i64 {
    io.stdout().writeln("=== Running: test_datetime_offset_equivalence ===");

    let local:
        Result<DateTime, ParseError> =
        DateTime.parse(
            "2024-01-01T00:00:00+02:00"
        );

    let utc:
        Result<DateTime, ParseError> =
        DateTime.parse(
            "2023-12-31T22:00:00Z"
        );

    let local_value: DateTime =
        match (local) {
            case Result.Ok { value } -> value,

            case Result.Err { error } -> {
                io.stdout().writeln("[FAIL] +02:00 DateTime failed to parse");
                return 1;
            },
        };

    let utc_value: DateTime =
        match (utc) {
            case Result.Ok { value } -> value,

            case Result.Err { error } -> {
                io.stdout().writeln("[FAIL] UTC DateTime failed to parse");
                return 2;
            },
        };

    let difference: Duration =
        local_value.difference(utc_value);

    if (difference.total_nanoseconds() != 0) {
        io.stdout().writeln(
            "[FAIL] equivalent offset DateTimes differ"
        );
        return 3;
    }

    io.stdout().writeln("[PASS] DateTime offset equivalence");

    return 0;
}


func test_datetime_epoch_conversion(): i64 {
    io.stdout().writeln("=== Running: test_datetime_epoch_conversion ===");

    let epoch: DateTime =
        DateTime.from_seconds(0, 0, 0);

    if (epoch.to_seconds() != 0) {
        io.stdout().writeln("[FAIL] Unix epoch roundtrip failed");
        return 1;
    }

    let negative:
        DateTime =
        DateTime.from_seconds(
            -1,
            500_000_000,
            0
        );

    if (negative.to_seconds() != -1) {
        io.stdout().writeln("[FAIL] negative Unix time roundtrip failed");
        return 2;
    }

    let offset_epoch:
        DateTime =
        DateTime.from_seconds(
            0,
            0,
            120
        );

    if (offset_epoch.to_seconds() != 0) {
        io.stdout().writeln("[FAIL] offset Unix time roundtrip failed");
        return 3;
    }

    io.stdout().writeln("[PASS] DateTime Unix conversion");

    return 0;
}


func test_datetime_arithmetic(): i64 {
    io.stdout().writeln("=== Running: test_datetime_arithmetic ===");

    let base:
        Result<DateTime, ParseError> =
        DateTime.parse(
            "2024-02-28T23:59:59.500000000Z"
        );

    let base_value:
        DateTime =
        match (base) {
            case Result.Ok { value } -> value,

            case Result.Err { error } -> {
                io.stdout().writeln("[FAIL] base DateTime failed to parse");
                return 1;
            },
        };

    let delta:
        Duration =
        Duration.from_milliseconds(1500);

    let advanced:
        DateTime =
        base_value.add(delta);

    let elapsed:
        Duration =
        advanced.difference(base_value);

    if (elapsed.total_nanoseconds() != 1_500_000_000) {
        io.stdout().writeln("[FAIL] DateTime + Duration produced wrong difference");
        return 2;
    }

    // Crossing both the second and day boundary.
    if (advanced.to_seconds() != 1709164801) {
        io.stdout().writeln("[FAIL] DateTime arithmetic crossed boundary incorrectly");
        return 3;
    }

    let restored:
        DateTime =
        advanced.subtract(delta);

    let restored_difference:
        Duration =
        restored.difference(base_value);

    if (restored_difference.total_nanoseconds() != 0) {
        io.stdout().writeln("[FAIL] DateTime subtract() did not restore original time");
        return 4;
    }

    io.stdout().writeln("[PASS] DateTime arithmetic");

    return 0;
}


func test_datetime_difference(): i64 {
    io.stdout().writeln("=== Running: test_datetime_difference ===");

    let first:
        Result<DateTime, ParseError> =
        DateTime.parse(
            "2025-06-01T12:00:00.250000000Z"
        );

    let second:
        Result<DateTime, ParseError> =
        DateTime.parse(
            "2025-06-01T12:00:01.750000000Z"
        );

    let a: DateTime =
        match (first) {
            case Result.Ok { value } -> value,

            case Result.Err { error } -> {
                io.stdout().writeln("[FAIL] first DateTime failed to parse");
                return 1;
            },
        };

    let b: DateTime =
        match (second) {
            case Result.Ok { value } -> value,

            case Result.Err { error } -> {
                io.stdout().writeln("[FAIL] second DateTime failed to parse");
                return 2;
            },
        };

    let difference:
        Duration =
        b.difference(a);

    if (difference.total_nanoseconds() != 1_500_000_000) {
        io.stdout().writeln("[FAIL] DateTime.difference() produced wrong duration");
        return 3;
    }

    io.stdout().writeln("[PASS] DateTime difference");

    return 0;
}


func test_instant_arithmetic(): i64 {
    io.stdout().writeln("=== Running: test_instant_arithmetic ===");

    let start:
        Instant =
        Instant.now();

    let delta:
        Duration =
        Duration.from_milliseconds(2500);

    let later:
        Instant =
        start.add(delta);

    let difference:
        Duration =
        later.difference(start);

    if (difference.total_nanoseconds() != 2_500_000_000) {
        io.stdout().writeln("[FAIL] Instant.add() produced wrong difference");
        return 1;
    }

    let restored:
        Instant =
        later.subtract(delta);

    let restored_difference:
        Duration =
        restored.difference(start);

    if (restored_difference.total_nanoseconds() != 0) {
        io.stdout().writeln("[FAIL] Instant.subtract() did not restore original instant");
        return 2;
    }

    io.stdout().writeln("[PASS] Instant arithmetic");

    return 0;
}


func test_instant_monotonic_clock(): i64 {
    io.stdout().writeln("=== Running: test_instant_monotonic_clock ===");

    let start:
        Instant =
        Instant.now();

    process.sleep(
        Duration.from_milliseconds(2)
    );

    let end:
        Instant =
        Instant.now();

    let elapsed:
        Duration =
        end.difference(start);

    if (elapsed.is_negative()) {
        io.stdout().writeln("[FAIL] monotonic clock went backwards");
        return 1;
    }

    if (elapsed.total_nanoseconds() < 1_000_000) {
        io.stdout().writeln("[FAIL] elapsed time was unexpectedly short");
        return 2;
    }

    io.stdout().writeln("[PASS] CLOCK_MONOTONIC + sleep");

    return 0;
}


func test_datetime_realtime_clock(): i64 {
    io.stdout().writeln("=== Running: test_datetime_realtime_clock ===");

    let now:
        DateTime =
        DateTime.now();

    let unix_seconds:
        i64 =
        now.to_seconds();

    io.stdout().writeln(
        "[PASS] CLOCK_REALTIME returned Unix seconds:"
    );
    io.stdout().writeln(unix_seconds.to_string().as_str());

    return 0;
}


