    }

    let status7: i64 = test_thread_fnonce_capture();
    if (status7 != 0) {
        return status7;
    }

    let status8: i64 = test_thread_nested_computation();
    if (status8 != 0) {
        return status8;
    }

    let status9: i64 = test_thread_repeated_spawn_join();
    if (status9 != 0) {
