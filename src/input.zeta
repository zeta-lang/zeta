    defer io.stdout().writeln("  -> Second defer");
    defer io.stdout().writeln("  -> Third defer");

    io.stdout().writeln("  -> Inside function body");

    io.stdout().writeln("[PASS] test_defer_lifo (check stdout for LIFO order)");
    return 0;
}

