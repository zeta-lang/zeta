static let mut G_COUNTER: i64 = 0;
static let G_CONST: i64 = 1234;
static let mut G_POINT: Point = Point { x: 1, y: 2 };
static let mut G_ARR: [8]i64 = [0, 0, 0, 0, 0, 0, 0, 0];
static let mut G_DROPPABLE: DroppableItem = DroppableItem { tag: "static_droppable" };
static let mut G_LINE: Line = Line {
    start: Point { x: 0, y: 0 },
    end: Point { x: 0, y: 0 },
};

func static_bump(): i64 {
    G_COUNTER += 1;
    return G_COUNTER;
}

func static_fill_point(p: &alias Point, v: i64) {
    p.x = v;
    p.y = v;
}

// Read, write, compound-assign without any unsafe block.
func test_static_read_write(): i64 {
    io.stdout().writeln("=== Running: test_static_read_write ===");

    if (G_CONST != 1234) {
        io.stdout().writeln("[FAIL] static initializer wrong");
        return 1;
    }

    G_COUNTER = 5;
    if (G_COUNTER != 5) {
        io.stdout().writeln("[FAIL] static assignment not visible");
        return 2;
    }

    G_COUNTER += 10;
    G_COUNTER *= 2;
    if (G_COUNTER != 30) {
        io.stdout().writeln("[FAIL] static compound assignment wrong");
        return 3;
    }

    G_COUNTER = 0;
    io.stdout().writeln("[PASS] static read/write, no unsafe");
    return 0;
}

// State survives across calls and is shared between functions.
func test_static_persists_across_calls(): i64 {
    io.stdout().writeln("=== Running: test_static_persists_across_calls ===");

    G_COUNTER = 0;
    static_bump();
    static_bump();
    let third: i64 = static_bump();

    if (third != 3 || G_COUNTER != 3) {
        io.stdout().writeln("[FAIL] static did not persist across calls");
        return 1;
    }

    G_COUNTER = 0;
    io.stdout().writeln("[PASS] static persists across calls");
    return 0;
}

// Fields and nested fields of an aggregate static.
func test_static_struct_fields(): i64 {
    io.stdout().writeln("=== Running: test_static_struct_fields ===");

    G_POINT.x = 10;
    io.stdout().writeln(G_POINT.x.to_string().as_str());
    G_POINT.y = 20;
    io.stdout().writeln(G_POINT.y.to_string().as_str());

    if (G_POINT.x + G_POINT.y != 30) {
        io.stdout().writeln("[FAIL] static struct field write");
        return 1;
    }

    G_LINE.start.x = 1;
    G_LINE.start.y = 2;
    G_LINE.end.x = 11;
    G_LINE.end.y = 22;

    let dx: i64 = G_LINE.end.x - G_LINE.start.x;
    let dy: i64 = G_LINE.end.y - G_LINE.start.y;
    if (dx != 10 || dy != 20) {
        io.stdout().writeln("[FAIL] static nested struct fields");
        return 2;
    }

    G_POINT = Point { x: 7, y: 8 };
    io.stdout().writeln(G_POINT.x.to_string().as_str());
    io.stdout().writeln(G_POINT.y.to_string().as_str());
    let px: i64 = G_POINT.x;
    io.stdout().writeln(px.to_string().as_str());
    if (G_POINT.x != 7 || G_POINT.y != 8) {
        io.stdout().writeln("[FAIL] whole-struct static assignment");
        return 3;
    }

    io.stdout().writeln("[PASS] static struct fields");
    return 0;
}

// Static array element access and slicing.
func test_static_array(): i64 {
    io.stdout().writeln("=== Running: test_static_array ===");

    let mut i: usize = 0;
    while (i < 8) {
        G_ARR[i] = (i as i64) * 3;
        i += 1;
    }

    if (G_ARR[0] != 0 || G_ARR[3] != 9 || G_ARR[7] != 21) {
        io.stdout().writeln("[FAIL] static array element mismatch");
        return 1;
    }

    let s: &alias []i64 = &alias G_ARR[2..<6];
    s[0] = 99;
    if (G_ARR[2] != 99) {
        io.stdout().writeln("[FAIL] write through slice of static array not visible");
        return 2;
    }

    io.stdout().writeln("[PASS] static array");
    return 0;
}

// Taking &mut of a static must be allowed with no unsafe, and stay valid.
func test_static_borrow_no_unsafe(): i64 {
    io.stdout().writeln("=== Running: test_static_borrow_no_unsafe ===");

    G_POINT = Point { x: 0, y: 0 };
    static_fill_point(&alias G_POINT, 5);
    if (G_POINT.x != 5 || G_POINT.y != 5) {
        io.stdout().writeln("[FAIL] &mut static not written by callee");
        return 1;
    }

    let r: &alias i64 = &alias G_COUNTER;
    *r = 77;
    if (G_COUNTER != 77) {
        io.stdout().writeln("[FAIL] &mut static scalar not visible");
        return 2;
    }

    G_COUNTER = 0;
    io.stdout().writeln("[PASS] &mut to static without unsafe");
    return 0;
}

func test_static_aliasing_allowed(): i64 {
    io.stdout().writeln("=== Running: test_static_aliasing_allowed ===");

    G_COUNTER = 0;

    let a: &alias i64 = &alias G_COUNTER;
    let b: &alias i64 = &alias G_COUNTER;

    *a = 1;
    *b += 1;
    G_COUNTER += 1; // direct access while a and b are live

    if (*a != 3 || *b != 3 || G_COUNTER != 3) {
        io.stdout().writeln("[FAIL] aliased static accesses disagree");
        return 1;
    }

    G_COUNTER = 0;
    io.stdout().writeln("[PASS] overlapping &mut to static accepted and coherent");
    return 0;
}

// Non-capturing use of statics inside closures: nothing is captured, so nothing to Send.
func test_static_in_closure(): i64 {
    io.stdout().writeln("=== Running: test_static_in_closure ===");

    G_COUNTER = 0;

    io.stdout().writeln(G_COUNTER.to_string().as_str());

    apply_mut(
        func() {
            G_COUNTER += 1;
            io.stdout().writeln(G_COUNTER.to_string().as_str());
        }
    );

    io.stdout().writeln(G_COUNTER.to_string().as_str());
    if (G_COUNTER != 2) {
        io.stdout().writeln("[FAIL] closure did not mutate static twice");
        return 1;
    }

    let r: i64 = apply(
        func(x: i64) {
            return x + G_CONST;
        },
        6
    );

    if (r != 1240) {
        io.stdout().writeln("[FAIL] closure read of static wrong");
        return 2;
    }

    // $sizeof on a closure that only touches statics: env should be empty.
    if (probe(func() { return G_CONST; }) != 0) {
        io.stdout().writeln("[FAIL] closure env captured a static (should be size 0)");
        return 3;
    }

    G_COUNTER = 0;
    io.stdout().writeln("[PASS] statics used in closures without capture");
    return 0;
}

// A non-Send, non-Sync type in a static, spawned threads touch it with no Mutex/Arc.
struct RawHolderStatic {
    ptr: [*]mut i64,
}

