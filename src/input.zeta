struct Subject {
    value: i64,
    observer: ?&alias Observer,
}

struct Observer {
    last_value: i64,
}

func notify(subject: &alias Subject) {
    match (subject.observer) {
        case null -> {},

        case observer -> {
            observer.last_value = subject.value;
        },
    }
}

func test_observer_pattern(): i64 {
    io.stdout().writeln("=== Running: test_observer_pattern ===");

    let mut observer: Observer = Observer {
        last_value: 0,
    };

    let mut subject: Subject = Subject {
        value: 0,
        observer: &alias observer,
    };

    subject.value = 10;
    notify(&alias subject);

    if (observer.last_value != 10) {
        io.stdout().writeln("[FAIL] observer did not receive 10");
        return 1;
    }

    subject.value = 42;
    notify(&alias subject);

    if (observer.last_value != 42) {
        io.stdout().writeln("[FAIL] observer did not receive 42");
        return 2;
    }

    io.stdout().writeln("[PASS] observer pattern");

    return 0;
}

struct Tile {
    kind: i64,
}

struct Level {
    tiles: [64]Tile,
}

unsafe impl Tile by Send {}
unsafe impl Level by Send {}

func fill_tiles(tiles: &mut []Tile, kind: i64) {
    let mut i: usize = 0;
    while (i < tiles.len) {
        tiles[i].kind = kind;
        i += 1;
    }
}

// Two disjoint &mut sub-slices of one array, each handed to its own scoped thread.
func test_scope_disjoint_slices(): i64 {
    io.stdout().writeln("=== Running: test_scope_disjoint_slices ===");

    let mut level: Level = Level { tiles: undefined };

    let done: i64 = scope(func(s: &alias Scope) {
        let a: &mut []Tile = &mut level.tiles[0..<16];
        let b: &mut []Tile = &mut level.tiles[16..<32];

        s.spawn(func() { fill_tiles(a, 1); return 0; });
        s.spawn(func() { fill_tiles(b, 2); return 0; });

        return 0;
    });

    // The scope has joined both threads, so `level` is usable again.
    if (level.tiles[0].kind != 1 || level.tiles[15].kind != 1) {
        io.stdout().writeln("[FAIL] first half not filled by thread a");
        return 1;
    }
    if (level.tiles[16].kind != 2 || level.tiles[31].kind != 2) {
        io.stdout().writeln("[FAIL] second half not filled by thread b");
        return 2;
    }
    if (level.tiles[32].kind != 0) {
        io.stdout().writeln("[FAIL] untouched region was modified");
        return 3;
    }

    io.stdout().writeln("[PASS] scope with disjoint &mut slices");
    return 0;
}

func test_scope_four_disjoint_slices(): i64 {
    io.stdout().writeln("=== Running: test_scope_disjoint_slices ===");

    let mut level: Level = Level { tiles: undefined };
    let N: i64 = 64;

    let done: i64 = scope(func(s: &alias Scope) {
        let a: &mut []Tile = &mut level.tiles[0..<(N / 4)];
        let b: &mut []Tile = &mut level.tiles[(N / 4)..<(N / 2)];
        let c: &mut []Tile = &mut level.tiles[(N / 2)..<(3 * N / 4)];
        let d: &mut []Tile = &mut level.tiles[(3 * N / 4)..<N];

        s.spawn(func() {
            fill_tiles(a, 1);
            return 0;
        });

        s.spawn(func() {
            fill_tiles(b, 2);
            return 0;
        });

        s.spawn(func() {
            fill_tiles(c, 3);
            return 0;
        });

        s.spawn(func() {
            fill_tiles(d, 4);
            return 0;
        });

        return 0;
    });

    // The scope has joined all four threads.
    if (level.tiles[0].kind != 1 || level.tiles[15].kind != 1) {
        io.stdout().writeln("[FAIL] first quarter not filled");
        return 1;
    }

    if (level.tiles[16].kind != 2 || level.tiles[31].kind != 2) {
        io.stdout().writeln("[FAIL] second quarter not filled");
        return 2;
    }

    if (level.tiles[32].kind != 3 || level.tiles[47].kind != 3) {
        io.stdout().writeln("[FAIL] third quarter not filled");
        return 3;
    }

    if (level.tiles[48].kind != 4 || level.tiles[63].kind != 4) {
        io.stdout().writeln("[FAIL] fourth quarter not filled");
        return 4;
    }

    io.stdout().writeln("[PASS] scope with four disjoint &mut slices");
    return 0;
}

