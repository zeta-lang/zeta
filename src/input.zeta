// Statics are never dropped: no scope-exit drop, and reassignment still drops the old value.
func test_static_drop_semantics(): i64 {
    io.stdout().writeln("=== Running: test_static_drop_semantics ===");

    io.stdout().writeln("Reassigning static (expect ONE drop of 'static_droppable' right after this line)...");
    G_DROPPABLE = DroppableItem { tag: "static_replaced" };

    if (G_DROPPABLE.tag.ne("static_replaced")) {
        io.stdout().writeln("[FAIL] static droppable not replaced");
        return 1;
    }

    io.stdout().writeln("[PASS] static droppable reassign");
    io.stdout().writeln("Expect NO drop of 'static_replaced' at function exit or program exit.");
    return 0;
}

func test_static_moves_out(): i64 {
    io.stdout().writeln("=== Running: test_static_moves_out ===");

    // Moving out of a static must not be rejected (no move checking on statics).
    let a: DroppableItem = G_DROPPABLE;
    let b: DroppableItem = G_DROPPABLE;

    if (a.tag.ne("static_replaced") || b.tag.ne("static_replaced")) {
        io.stdout().writeln("[FAIL] moved-from static was not readable");
        return 1;
    }

    io.stdout().writeln("[PASS] move out of static accepted, twice");
    io.stdout().writeln("(a and b both drop at scope end: double drop is the programmer's problem here)");
    return 0;
}

func static_tests(): i64 {
    let s1: i64 = test_static_read_write();
    if (s1 != 0) { return s1; }

    let s2: i64 = test_static_persists_across_calls();
    if (s2 != 0) { return s2; }

    let s4: i64 = test_static_struct_fields();
    if (s4 != 0) { return s4; }

    let s5: i64 = test_static_array();
    if (s5 != 0) { return s5; }

    let s6: i64 = test_static_borrow_no_unsafe();
    if (s6 != 0) { return s6; }

    let s7: i64 = test_static_aliasing_allowed();
    if (s7 != 0) { return s7; }

    let s8: i64 = test_static_in_closure();
    if (s8 != 0) { return s8; }

    // let s9: i64 = test_static_thread_no_send_sync();
    // if (s9 != 0) { return s9; }

//     let s10: i64 = test_static_scope_threads();
//     if (s10 != 0) { return s10; }
//
//     let s11: i64 = test_static_data_race_allowed();
//     if (s11 != 0) { return s11; }

    let s12: i64 = test_static_drop_semantics();
    if (s12 != 0) { return s12; }

    io.stdout().writeln("=== All static tests passed ===");
    return 0;
}
