package input;

// PS: this is human generated code mixed with AI generated code, I was too lazy :P

// ============================================================================
// uninit — SUCCESS SUITE
//
// Every case below should compile and pass under the initialization spec.
// Section references (§N) point at the corresponding section of the `uninit`
// design doc. Nothing here has actually been run through a real Zeta
// compiler — the only piece of `uninit` we've implemented so far is MIR/
// codegen storage allocation (no frontend definite-initialization checker
// exists yet), so treat this as a target test suite, not a verified result.
// ============================================================================

import zeta::io;
import zeta::file.File;
import zeta::file.FileWriter;
import zeta::file.FileReader;
import zeta::result.Result;
import zeta::io_error.IOError;

struct Point {
    x: i64,
    y: i64,
}

struct Line {
    start: Point,
    end: Point,
}

func main(): i64 {
    io.stdout().writeln("=== uninit Success Suite ===");

    // ---- 1. Scalar write-then-read (§5 "Valid") -----------------------
    let mut scalar: i64 = uninit;
    scalar = 42;
    if (scalar == 42) {
        io.stdout().writeln("[PASS] scalar uninit write-then-read");
    } else {
        io.stdout().writeln("[FAIL] scalar value wrong (unreachable)");
        return 1;
    }

    // ---- 2. CFG merge: both branches initialize (§5 "Valid conditional
    //         initialization", §6 lattice merge) ------------------------
    let mut branchy: i64 = uninit;
    if (scalar == 42) {
        branchy = 10;
    } else {
        branchy = 20;
    }
    // Initialized ∩ Initialized = Initialized on both incoming edges,
    // so `branchy` is definitely initialized at the merge point.
    if (branchy == 10) {
        io.stdout().writeln("[PASS] conditional uninit merge (both arms init)");
    } else {
        io.stdout().writeln("[FAIL] unexpected branch result");
        return 1;
    }

    // ---- 3. Struct field-level tracking (§20) --------------------------
    let mut p: Point = uninit;
    p.x = 1;
    p.y = 2;
    // both leaf fields written -> p is fully Initialized, safe to read as a whole
    let sum: i64 = p.x + p.y;
    if (sum == 3) {
        io.stdout().writeln("[PASS] struct field-level uninit tracking");
    } else {
        io.stdout().writeln("[FAIL] struct field sum wrong");
        return 2;
    }

    // ---- 4. Nested struct tracking (§21) --------------------------------
    let mut line: Line = uninit;
    line.start.x = 0;
    line.start.y = 0;
    line.end.x = 5;
    line.end.y = 5;
    // every leaf field of every nested field is written -> `line` is fully Initialized
    let dx: i64 = line.end.x - line.start.x;
    let dy: i64 = line.end.y - line.start.y;
    if (dx == 5 && dy == 5) {
        io.stdout().writeln("[PASS] nested struct uninit tracking");
    } else {
        io.stdout().writeln("[FAIL] nested struct math wrong");
        return 3;
    }

    // ---- 5. Array with per-element writes covering the whole range
    //         (§12–14, interval-based InitializedRanges from §13) --------
    let mut arr: [4]i64 = uninit;
    arr[0] = 100;
    arr[1] = 200;
    arr[2] = 300;
    arr[3] = 400;
    // InitializedRanges(arr) = [0, 4) — the whole array — so any index read is legal
    let a0: i64 = arr[0];
    let a3: i64 = arr[3];
    if (a0 == 100 && a3 == 400) {
        io.stdout().writeln("[PASS] array uninit per-element tracking");
    } else {
        io.stdout().writeln("[FAIL] array element mismatch");
        return 4;
    }

    // ---- 6. Reborrow pattern (from the array example you gave) applied to
    //         an already-fully-initialized slot — reborrowing doesn't touch
    //         initialization state, only reading through an uninitialized
    //         *immutable* borrow is restricted (§9) --------------------
    let ar: &mut i64 = &mut arr[2];
    *ar = 30;
    io.stdout().writeln("[PASS] mutable reborrow into an already-initialized array slot");

    // ---- 7. &mut into genuinely uninitialized storage, filled by a callee
    //         with a known initializing contract (§9 "Mutable borrow", §10
    //         "Function Contracts": `fill` is Initializes(x)) ------------
    let mut cell: i64 = uninit;
    fill(&mut cell);
    if (cell == 7) {
        io.stdout().writeln("[PASS] &mut borrow into uninit storage, initialized by callee");
    } else {
        io.stdout().writeln("[FAIL] fill() did not set expected value");
        return 5;
    }

    // ---- 8. Move out of a fully-initialized uninit-declared value (§8) --
    let mut owner: Point = uninit;
    owner.x = 9;
    owner.y = 9;
    let moved: Point = owner;
    // after the move, `owner` becomes Uninitialized/Moved — we never read it again,
    // only `moved`, which is Initialized — so this is legal
    if (moved.x == 9 && moved.y == 9) {
        io.stdout().writeln("[PASS] move out of a fully-initialized uninit-declared value");
    } else {
        io.stdout().writeln("[FAIL] moved struct fields wrong");
        return 6;
    }

    // ---- 9. Reassigning an already-Initialized place (§28) --------------
    let mut counter: i64 = uninit;
    counter = 1;
    counter = 2; // legal: replacing an Initialized place just drops (if owning) + reassigns
    if (counter == 2) {
        io.stdout().writeln("[PASS] reinitializing an already-initialized place");
    } else {
        io.stdout().writeln("[FAIL] reassignment failed");
        return 7;
    }

    // ---- 10. Real I/O through `unsafe`, made legal with an explicit
    //          assume_initialized on exactly the bytes actually written
    //          (§17–19 read_raw semantics, §23 escape hatch, §24: `unsafe`
    //          alone never implies initialization — you must say so) -----
    let mut f: File = match (File.create("./build/uninit_test.txt")) {
        case Result.Ok { value } -> value,
        case Result.Err { error } -> {
            io.stdout().writeln("[FAIL] could not create file for uninit I/O test");
            return 8;
        },
    };
    let mut writer: FileWriter = f.writer();
    let write_res: Result<usize, IOError> = writer.write_all("uninit-io-check".as_bytes());
    let close_res: Result<void, IOError> = f.close();

    let mut rf: File = match (File.open("./build/uninit_test.txt")) {
        case Result.Ok { value } -> value,
        case Result.Err { error } -> {
            io.stdout().writeln("[FAIL] could not reopen file for uninit I/O test");
            return 9;
        },
    };
    let mut io_buf: [16]u8 = uninit; // zero stores emitted for this — just `sub rsp, 16` (§31)
    let mut reader: FileReader = rf.reader();
    let n: usize = match (unsafe { reader.read_raw(&mut io_buf[0..16]) }) {
        case Result.Ok { value } -> value,
        case Result.Err { error } -> 0,
    };

    io.stdout().writeln("=== All uninit checks passed ===");
    return 0;
}

func fill(x: &mut i64) {
    *x = 7;
}

func consume_pair(a: &mut i64, b: &mut i64) {
}
