func test_original_uninit_suite(): i64 {
    io.stdout().writeln("=== uninit Success Suite ===");

    let mut scalar: i64 = uninit;
    scalar = 42;
    if (scalar == 42) {
        io.stdout().writeln("[PASS] scalar uninit write-then-read");
    } else {
        io.stdout().writeln("[FAIL] scalar value wrong (unreachable)");
        return 1;
    }

    let mut branchy: i64 = uninit;
    if (scalar == 42) {
        branchy = 10;
    } else {
        branchy = 20;
    }

    if (branchy == 10) {
        io.stdout().writeln("[PASS] conditional uninit merge (both arms init)");
    } else {
        io.stdout().writeln("[FAIL] unexpected branch result");
        return 1;
    }

    let mut p: Point = uninit;
    p.x = 1;
    p.y = 2;
    let sum: i64 = p.x + p.y;
    if (sum == 3) {
        io.stdout().writeln("[PASS] struct field-level uninit tracking");
    } else {
        io.stdout().writeln("[FAIL] struct field sum wrong");
        return 2;
    }

    let mut line: Line = uninit;
    line.start.x = 0;
    line.start.y = 0;
    line.end.x = 5;
    line.end.y = 5;

    let dx: i64 = line.end.x - line.start.x;
    let dy: i64 = line.end.y - line.start.y;
    if (dx == 5 && dy == 5) {
        io.stdout().writeln("[PASS] nested struct uninit tracking");
    } else {
        io.stdout().writeln("[FAIL] nested struct math wrong");
        return 3;
    }

    let mut arr: [4]i64 = uninit;
    arr[0] = 100;
    arr[1] = 200;
    arr[2] = 300;
    arr[3] = 400;

    let a0: i64 = arr[0];
    let a3: i64 = arr[3];
    if (a0 == 100 && a3 == 400) {
        io.stdout().writeln("[PASS] array uninit per-element tracking");
    } else {
        io.stdout().writeln("[FAIL] array element mismatch");
        return 4;
    }

    let ar: &mut i64 = &mut arr[2];
    *ar = 30;
    io.stdout().writeln("[PASS] mutable reborrow into an already-initialized array slot");

    let mut cell: i64 = uninit;
    fill(&mut cell);
    if (cell == 7) {
        io.stdout().writeln("[PASS] &mut borrow into uninit storage, initialized by callee");
    } else {
        io.stdout().writeln("[FAIL] fill() did not set expected value");
        return 5;
    }

    let mut owner: Point = uninit;
    owner.x = 9;
    owner.y = 9;
    let moved: Point = owner;

    if (moved.x == 9 && moved.y == 9) {
        io.stdout().writeln("[PASS] move out of a fully-initialized uninit-declared value");
    } else {
        io.stdout().writeln("[FAIL] moved struct fields wrong");
        return 6;
    }

    let mut counter: i64 = uninit;
    counter = 1;
    counter = 2;
    if (counter == 2) {
        io.stdout().writeln("[PASS] reinitializing an already-initialized place");
    } else {
        io.stdout().writeln("[FAIL] reassignment failed");
        return 7;
    }

    let mut f: File = match (File.create("./build/uninit_test.txt")) {
        case Result.Ok { value } -> value,
        case Result.Err { error } -> {
            io.stdout().writeln("[FAIL] could not create file for uninit I/O test");
            return 8;
        },
    };
    let mut writer: FileWriter = f.writer();
    let write_res: Result<usize, IOError> = writer.write_all("uninit-io-check".as_bytes());
    let close_res: Result<void, IOError> = f.close();

    let mut rf: File = match (File.open("./build/uninit_test.txt")) {
        case Result.Ok { value } -> value,
        case Result.Err { error } -> {
            io.stdout().writeln("[FAIL] could not reopen file for uninit I/O test");
            return 9;
        },
    };
    let mut io_buf: [16]u8 = uninit;
    let mut reader: FileReader = rf.reader();
    let n: usize = match (unsafe { reader.read_raw(&mut io_buf[0..<16]) }) {
        case Result.Ok { value } -> value,
        case Result.Err { error } -> 0,
    };

    io.stdout().writeln("=== All original uninit checks passed ===");
    return 0;
}

func fill(x: &mut i64) {
    *x = 7;
}

func consume_pair(a: &mut i64, b: &mut i64) {
}

func apply<F: func(i64): i64>(fn: F, value: i64): i64 {
    return fn(value);
}

func test_generic_closure_constraint(): i64 {
    io.stdout().writeln("=== Running: test_generic_closure_constraint ===");

    let result: i64 = apply(
        func(x: i64) {
            return x * 2;
        },
        21
    );

    if (result != 42) {
        io.stdout().writeln("[FAIL] closure constraint invocation returned wrong value");
        return 1;
    }

    io.stdout().writeln("[PASS] generic constrained closure");

    return 0;
}


func test_generic_closure_multiple_instantiations(): i64 {
    io.stdout().writeln("=== Running: test_generic_closure_multiple_instantiations ===");

    let doubled: i64 = apply(
        func(x: i64) {
            return x * 2;
        },
        21
    );

    let incremented: i64 = apply(
        func(x: i64) {
            return x + 1;
        },
        41
    );

    let squared: i64 = apply(
        func(x: i64) {
            return x * x;
        },
        7
    );

    if (doubled != 42) {
        io.stdout().writeln("[FAIL] doubled closure");
        return 1;
    }

    if (incremented != 42) {
        io.stdout().writeln("[FAIL] incremented closure");
        return 2;
    }

    if (squared != 49) {
        io.stdout().writeln("[FAIL] squared closure");
        return 3;
    }

    io.stdout().writeln("[PASS] multiple constrained closure instantiations");

    return 0;
}

func apply_droppable<F: func(): str>(fn: F): str {
    return fn();
}

func test_generic_closure_capture_owned(): i64 {
    io.stdout().writeln("=== Running: test_generic_closure_capture_owned ===");

    let item: DroppableItem = DroppableItem {
        tag: "clear_one"
    };

    let result: str = apply_droppable(
        func() {
            return item.tag;
        }
    );

    if (result.ne("clear_one")) {
        io.stdout().writeln("[FAIL] captured DroppableItem had wrong value");
        return 1;
    }

    io.stdout().writeln("[PASS] owning closure capture");

    return 0;
}

func apply_mut<F: func(): void>(fn: F) {
    fn();
    fn();
}

func call_once<F: func(): DroppableItem>(fn: F): DroppableItem {
    return fn();
}

// FnMut: the closure mutates a captured local.
func test_closure_fnmut_counter(): i64 {
    io.stdout().writeln("=== Running: test_closure_fnmut_counter ===");

    let mut counter: i64 = 0;

    apply_mut(
        func() {
            counter += 1;
        }
    );

    if (counter != 2) {
        io.stdout().writeln("[FAIL] FnMut closure did not mutate the captured local twice");
        return 1;
    }

    io.stdout().writeln("[PASS] FnMut closure mutates captured local");

    return 0;
}

// FnOnce: the closure moves an owned capture out through its return value.
func test_closure_fnonce_moves_capture(): i64 {
    io.stdout().writeln("=== Running: test_closure_fnonce_moves_capture ===");

    let item: DroppableItem = DroppableItem { tag: "fnonce_moved" };

    let taken: DroppableItem = call_once(
        func() {
            return item;
        }
    );

    if (taken.tag.ne("fnonce_moved")) {
        io.stdout().writeln("[FAIL] FnOnce closure returned the wrong item");
        return 1;
    }

    io.stdout().writeln("[PASS] FnOnce closure moved its capture out");
    io.stdout().writeln("Expect exactly ONE drop of 'fnonce_moved' after this line (from `taken`, not `item`)");

    return 0;
}

// A closure literal inside a loop body is checked more than once.
func test_closure_in_loop(): i64 {
    io.stdout().writeln("=== Running: test_closure_in_loop ===");

    let mut total: i64 = 0;
    let mut i: i64 = 0;

    while (i < 3) {
        total = apply(
            func(x: i64) {
                return x + i;
            },
            total
        );
        i += 1;
    }

    // (0 + 0) -> 0, (0 + 1) -> 1, (1 + 2) -> 3
    if (total != 3) {
        io.stdout().writeln("[FAIL] closure in loop produced the wrong total");
        return 1;
    }

    io.stdout().writeln("[PASS] closure inside a loop body");

    return 0;
}

// The inner closure captures `base` through the outer closure's capture.
func test_closure_nested(): i64 {
    io.stdout().writeln("=== Running: test_closure_nested ===");

    let base: i64 = 10;

    let result: i64 = apply(
        func(x: i64) {
            return apply(
                func(y: i64) {
                    return y + base;
                },
                x
            );
        },
        5
    );

    if (result != 15) {
        io.stdout().writeln("[FAIL] nested closure capture had the wrong value");
        return 1;
    }

    io.stdout().writeln("[PASS] nested closure capture");

    return 0;
}

