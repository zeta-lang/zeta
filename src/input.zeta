    } else {
        io.stdout().writeln("[PASS] new list was empty");
    }

    match (list.head) {
        case null -> {
            io.stdout().writeln("[PASS] new list head was empty");
        },

        case head_value -> {
            io.stdout().writeln("[FAIL] new list head was not null");
            return 2;
        },
    }

    match (list.tail) {
        case null -> {
            io.stdout().writeln("[PASS] new list taill was empty");
        },

        case tail_value -> {
            io.stdout().writeln("[FAIL] new list tail was not null");
            return 3;
        },
    }

    io.stdout().writeln("[PASS] new list");

    return 0;
}

