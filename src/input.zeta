struct DroppableItem {
    tag: str,
}

impl DroppableItem by Drop {
    func drop(mut this): void {
        let mut out: FileWriter = io.stdout();
        out.writeln("  -> [DROP] ArrayList DroppableItem");
        out.writeln("  tag:");
        out.writeln(this.tag);
    }
}


func test_array_list_default_generic(): i64 {
    io.stdout().writeln("=== Running: test_array_list_default_generic ===");

    // The allocator should default to Mallocator.
    let mut list: ArrayList<i64> = ArrayList.new();

    if (list.len() != 0) {
        io.stdout().writeln("[FAIL] new() should create empty list");
        return 1;
    }

    if (list.cap() != 16) {
        io.stdout().writeln("[FAIL] new() should have capacity 16");
        return 2;
    }

    io.stdout().writeln("[PASS] ArrayList<i64> uses default Mallocator");

    list.push(10);
    io.stdout().writeln("[PASS] Pushed 10");
    list.push(20);
    io.stdout().writeln("[PASS] Pushed 20");
    list.push(30);
    io.stdout().writeln("[PASS] Pushed 30");

    if (list.len() != 3) {
        io.stdout().writeln("[FAIL] push() did not update length");
        return 3;
    }

    if (*list.get(0) != 10) {
        io.stdout().writeln("[FAIL] get(0) returned wrong value");
        return 4;
    }

    if (*list.get(1) != 20) {
        io.stdout().writeln("[FAIL] get(1) returned wrong value");
        return 5;
    }

    if (*list.get(2) != 30) {
        io.stdout().writeln("[FAIL] get(2) returned wrong value");
        return 6;
    }

    io.stdout().writeln("[PASS] basic push/get");

    let mut value: &mut i64 = list.get_mut(1);
    *value = 200;

    if (*list.get(1) != 200) {
        io.stdout().writeln("[FAIL] get_mut() did not modify element");
        return 7;
    }

    io.stdout().writeln("[PASS] get_mut()");

    // let maybe: ?&i64 = list.try_get(1);

    // match (maybe) {
    //     case null -> {
    //         io.stdout().writeln("[FAIL] try_get(1) returned null");
    //         return 8;
    //     },
    //     case value -> {
    //         if (*value != 200) {
    //             io.stdout().writeln("[FAIL] try_get(1) returned wrong value");
    //             return 9;
    //         }
    //     },
    // }

    // let missing: ?&i64 = list.try_get(999);

    // match (missing) {
    //     case null -> {
    //         io.stdout().writeln("[PASS] try_get() correctly returned null");
    //     },
    //     case value -> {
    //         io.stdout().writeln("[FAIL] try_get(999) should return null");
    //         return 10;
    //     },
    // }

    io.stdout().writeln("=== Default generic test passed ===");
    return 0;
}


func test_array_list_explicit_allocator(): i64 {
    io.stdout().writeln("=== Running: test_array_list_explicit_allocator ===");

    let alloc: Mallocator = Mallocator {};
    let mut list: ArrayList<i64, Mallocator> =
        ArrayList.new_in(alloc);

    list.push(111);
    list.push(222);
    list.push(333);

    if (list.len() != 3) {
        io.stdout().writeln("[FAIL] explicit allocator list has wrong length");
        return 1;
    }

    if (*list.get(0) != 111 ||
        *list.get(1) != 222 ||
        *list.get(2) != 333) {
        io.stdout().writeln("[FAIL] explicit allocator list has wrong values");
        return 2;
    }

    io.stdout().writeln("[PASS] explicit ArrayList<i64, Mallocator>");

    return 0;
}


func test_array_list_with_capacity(): i64 {
    io.stdout().writeln("=== Running: test_array_list_with_capacity ===");

    let mut list: ArrayList<i64> =
        ArrayList.with_capacity(4);

    if (list.len() != 0) {
        io.stdout().writeln("[FAIL] with_capacity() should start empty");
        return 1;
    }

    if (list.cap() != 4) {
        io.stdout().writeln("[FAIL] with_capacity(4) returned wrong capacity");
        return 2;
    }

    list.push(1);
    list.push(2);
    list.push(3);
    list.push(4);

    if (list.len() != 4) {
        io.stdout().writeln("[FAIL] four pushes should produce len=4");
        return 3;
    }

    if (list.cap() != 4) {
        io.stdout().writeln("[FAIL] capacity should still be 4");
        return 4;
    }

    io.stdout().writeln("[PASS] capacity respected until growth");

    // This should trigger grow():
    // 4 -> 8
    list.push(5);

    if (list.len() != 5) {
        io.stdout().writeln("[FAIL] push after growth has wrong length");
        return 5;
    }

    if (list.cap() != 8) {
        io.stdout().writeln("[FAIL] growth should double capacity to 8");
        return 6;
    }

    if (*list.get(0) != 1 ||
        *list.get(1) != 2 ||
        *list.get(2) != 3 ||
        *list.get(3) != 4 ||
        *list.get(4) != 5) {
        io.stdout().writeln("[FAIL] growth corrupted existing elements");
        return 7;
    }

    io.stdout().writeln("[PASS] growth preserves existing elements");

    return 0;
}


func test_array_list_growth(): i64 {
    io.stdout().writeln("=== Running: test_array_list_growth ===");

    let mut list: ArrayList<i64> =
        ArrayList.with_capacity(1);

    let mut i: usize = 0;

    while (i < 100) {
        list.push(i as i64);
        i += 1;
    }

    if (list.len() != 100) {
        io.stdout().writeln("[FAIL] expected len=100 after 100 pushes");
        return 1;
    }

    i = 0;

    while (i < 100) {
        if (*list.get(i) != i as i64) {
            io.stdout().writeln("[FAIL] growth corrupted element");
            return 2;
        }

        i += 1;
    }

    io.stdout().writeln("[PASS] 100-element growth test");

    return 0;
}


func test_array_list_slice(): i64 {
    io.stdout().writeln("=== Running: test_array_list_slice ===");

    let mut list: ArrayList<i64> =
        ArrayList.with_capacity(8);

    list.push(10);
    list.push(20);
    list.push(30);
    list.push(40);
    list.push(50);

    let slice: &[]i64 = list.as_slice();

    if (slice.len != 5) {
        io.stdout().writeln("[FAIL] as_slice() returned wrong length");
        return slice.len as i64;
    }

    if (slice[0] != 10 ||
        slice[1] != 20 ||
        slice[2] != 30 ||
        slice[3] != 40) {
        io.stdout().writeln("[FAIL] as_slice() returned wrong values");
        return 2;
    }

    io.stdout().writeln("[PASS] as_slice()");

    return 0;
}


func test_array_list_try_get_mut(): i64 {
    io.stdout().writeln("=== Running: test_array_list_try_get_mut ===");

    let mut list: ArrayList<i64> =
        ArrayList.with_capacity(4);

    list.push(1);
    list.push(2);
    list.push(3);

    let resultttttt: &mut i64 = list.get_mut(1);
    io.stdout().writeln(resultttttt.to_string().as_str());

    let result: ?&mut i64 = list.try_get_mut(1);

    match (result) {
        case null -> {
            io.stdout().writeln("[FAIL] try_get_mut(1) returned null");
            return 1;
        },

        case value -> {
            *value = 999;
        },
    }

    if (*list.get(1) != 999) {
        io.stdout().writeln("[FAIL] try_get_mut() failed to modify value");
        return 2;
    }

    let invalid: ?&mut i64 = list.try_get_mut(3);

    match (invalid) {
        case null -> {
            io.stdout().writeln("[PASS] try_get_mut() correctly rejects len index");
        },

        case value -> {
            io.stdout().writeln("[FAIL] try_get_mut(3) should return null");
            return 3;
        },
    }

    return 0;
}


func test_array_list_drop_elements(): i64 {
    io.stdout().writeln("=== Running: test_array_list_drop_elements ===");

    io.stdout().writeln(
        "Creating ArrayList<DroppableItem> with capacity 2..."
    );

    let mut list: ArrayList<DroppableItem> =
        ArrayList.with_capacity(2);

    list.push(DroppableItem { tag: "one" });
    list.push(DroppableItem { tag: "two" });

    io.stdout().writeln(
        "Pushing third item -- this should grow the allocation..."
    );

    list.push(DroppableItem { tag: "three" });

    io.stdout().writeln(
        "Replacing element 0..."
    );

    *list.get_mut(0) =
        DroppableItem { tag: "replacement" };

    io.stdout().writeln(
        "Leaving ArrayList<DroppableItem> scope..."
    );

    // IMPORTANT:
    // This test is specifically intended to expose whether ArrayList
    // correctly drops initialized elements when the ArrayList itself dies.

    // Expected:
    //   one/replacement, two, three
    // should each eventually be dropped exactly once.

    // If grow() moves elements incorrectly, this can also expose
    // double-drops or leaked drops.

    return 0;
}


func test_array_list_clear(): i64 {
    io.stdout().writeln("=== Running: test_array_list_clear ===");

    let mut list: ArrayList<DroppableItem> =
        ArrayList.with_capacity(4);

    list.push(DroppableItem { tag: "clear_one" });
    list.push(DroppableItem { tag: "clear_two" });
    list.push(DroppableItem { tag: "clear_three" });

    io.stdout().writeln(
        "Calling clear()..."
    );

    io.stdout().writeln(list.get(0).tag);
    io.stdout().writeln(list.get(1).tag);
    io.stdout().writeln(list.get(2).tag);
    list.clear();

    if (list.len() != 0) {
        io.stdout().writeln("[FAIL] clear() did not set len=0");
        return 1;
    }

    if (list.cap() != 4) {
        io.stdout().writeln("[FAIL] clear() should preserve capacity");
        return 2;
    }

    io.stdout().writeln("[PASS] clear() length/capacity semantics");

    return 0;
}


func test_array_list_reuse_after_clear(): i64 {
    io.stdout().writeln("=== Running: test_array_list_reuse_after_clear ===");

    let mut list: ArrayList<i64> =
        ArrayList.with_capacity(4);

    list.push(10);
    list.push(20);
    list.push(30);

    list.clear();

    if (list.len() != 0) {
        io.stdout().writeln("[FAIL] list was not empty after clear");
        return 1;
    }

    list.push(100);
    list.push(200);

    if (list.len() != 2) {
        io.stdout().writeln("[FAIL] push after clear produced wrong len");
        return 2;
    }

    if (*list.get(0) != 100 ||
        *list.get(1) != 200) {
        io.stdout().writeln("[FAIL] push after clear produced wrong values");
        return 3;
    }

    io.stdout().writeln("[PASS] reuse after clear");

    return 0;
}

