func test_thread_nested_computation(): i64 {
    io.stdout().writeln("=== Running: test_thread_nested_computation ===");

    let base: i64 = 100;

    let mut handle: JoinHandle<i64, Mallocator> =
        threads.spawn(
            move func() {
                let mut value: i64 = base;

                value *= 2;
                value += 50;
                value -= 25;

                return value;
            }
        );

    let result: i64 = handle.join().unwrap();

    if (result != 225) {
        io.stdout().writeln("[FAIL] nested computation returned wrong value");
        return 1;
    }

    io.stdout().writeln("[PASS] captured computation");

    return 0;
}


func mutex_ok(): i64 {
    io.stdout().writeln("=== Running: mutex_ok ===");

    let x: Arc<Mutex<i64>> = Arc.new(Mutex.new(0));
    let x_thread: Arc<Mutex<i64>> = x.clone();

    let mut handle: JoinHandle<i64, Mallocator> =
        threads.spawn(move func() {
            let mut lock: MutexGuard<i64> = x_thread.get().lock();
            *lock.get_mut() += 1;
            return *lock.get();
        });

    let r: i64 = handle.join().unwrap();

    if (r != 1) {
        io.stdout().writeln("[FAIL] mutex_ok wrong value");
        return 1;
    }

    io.stdout().writeln("[PASS] mutex_ok");
    return 0;
}


func mutex_contention(): i64 {
    io.stdout().writeln("=== Running: mutex_contention ===");

    let x: Arc<Mutex<i64>> = Arc.new(Mutex.new(0));

    let mut handles: ArrayList<JoinHandle<i64, Mallocator>> = ArrayList.with_capacity(32);

    let mut i: i64 = 0;

    while (i < 32) {
        let x_thread: Arc<Mutex<i64>> = x.clone();

        let h: JoinHandle<i64, Mallocator> = threads.spawn(move func() {
            let mut j: i64 = 0;
            while (j < 1000) {
                let mut lock: MutexGuard<i64> = x_thread.get().lock();
                *lock.get_mut() += 1;
                j += 1;
            }
            return 0;
        });
        handles.push(h);

        i += 1;
    }

    i = 0;

    while (i < 32) {
        handles.get(i as usize).join().unwrap();
        i += 1;
    }

    let mut lock: MutexGuard<i64> = x.get().lock();
    let total: i64 = *lock.get();

    if (total != 32000) {
        io.stdout().writeln("[FAIL] mutex lost updates");
        return 1;
    }

    if (x.strong_count() != 1) {
        io.stdout().writeln("[FAIL] Arc clones were not released by the finished threads");
        io.stdout().writeln(x.strong_count().to_string().as_str());
        return 2;
    }

    io.stdout().writeln("[PASS] mutex contention, 32 threads x 1000 increments");
    return 0;
}

// ERROR: block value borrows from `lock`, dropped at end of block
//   threads.spawn(move func() { let lock = x1.get_alias().lock(); lock.get().get(0) });
// ERROR: use of moved value `x`
//   threads.spawn(move func() { x.get_alias().lock(); });
//   threads.spawn(move func() { x.get_alias().lock(); });
// ERROR: reference invalidated by drop (explicit drop while ref live)
//   let r = lock.get(); drop(lock); use(r);
func mutex_guard_ok(): i64 {
    let mut values: ArrayList<i64, Mallocator> = ArrayList.with_capacity(4);
    values.push(123);
    values.push(456);

    let x: Arc<Mutex<ArrayList<i64, Mallocator>>> = Arc.new(Mutex.new(values));
    let x1: Arc<Mutex<ArrayList<i64, Mallocator>>> = x.clone();
    let x2: Arc<Mutex<ArrayList<i64, Mallocator>>> = x.clone();

    threads.spawn(move func() {
        let mut lock: MutexGuard<ArrayList<i64, Mallocator>> = x1.get_alias().lock();
        let first: i64 = *lock.get_mut().get_mut(0); // copied out, guard still alive
    });

    threads.spawn(move func() {
        let mut lock: MutexGuard<ArrayList<i64, Mallocator>> = x2.get_alias().lock();
        lock.get_mut().remove(0);
    });
    return 0;
}

func test_scope_borrows_locals(): i64 {
    io.stdout().writeln("=== Running: test_scope_borrows_locals ===");

    let base: i64 = 100;

    let sum: i64 = scope(func(s: &alias Scope) {
        let mut h1: ScopedJoinHandle<i64> = s.spawn(func() { return base + 1; });
        let mut h2: ScopedJoinHandle<i64> = s.spawn(func() { return base + 2; });

        return h1.join().unwrap() + h2.join().unwrap();
    });

    if (sum != 203) {
        io.stdout().writeln("[FAIL] scoped threads returned wrong sum");
        return 1;
    }

    io.stdout().writeln("[PASS] scope borrows locals");
    return 0;
}

func test_scope_joins_unjoined(): i64 {
    io.stdout().writeln("=== Running: test_scope_joins_unjoined ===");

    let x: Mutex<i64> = Mutex.new(0);

    let done: i64 = scope(func(s: &alias Scope) {
        let mut i: i64 = 0;
        while (i < 8) {
            s.spawn(func() {
                let mut j: i64 = 0;
                while (j < 1000) {
                    let mut lock: MutexGuard<i64> = x.lock();
                    *lock.get_mut() += 1;
                    j += 1;
                }
                return 0;
            });
            i += 1;
        }
        return 0;
    });

    let mut lock: MutexGuard<i64> = x.lock();
    if (*lock.get() != 8000) {
        io.stdout().writeln("[FAIL] scope returned before its threads finished");
        return 1;
    }

    io.stdout().writeln("[PASS] scope joins unjoined threads");
    return 0;
}


