struct DroppableHolder {
    inner: DroppableItem,
}

struct Point {
    x: i64,
    y: i64,
}

struct Line {
    start: Point,
    end: Point,
}


func test_assignment_drops() {
    io.stdout().writeln("=== Running: test_assignment_drops ===");

    io.stdout().writeln("[Test 1.1] Initialized local reassignment:");
    let mut local_var: DroppableItem = DroppableItem { tag: "local_first" };
    io.stdout().writeln("  Assigning 'local_second' to local_var (expect drop of 'local_first')...");
    local_var = DroppableItem { tag: "local_second" };

    io.stdout().writeln("[Test 1.2] Uninitialized local first assignment & subsequent reassignment:");
    let mut uninit_var: DroppableItem = uninit;
    io.stdout().writeln("  First assignment to uninit_var (expect NO drop)...");
    uninit_var = DroppableItem { tag: "uninit_first_init" };
    io.stdout().writeln("  Reassigning uninit_var (expect drop of 'uninit_first_init')...");
    uninit_var = DroppableItem { tag: "uninit_second_init" };

    io.stdout().writeln("[Test 1.3] Struct field reassignment:");
    let mut holder: DroppableHolder = DroppableHolder {
        inner: DroppableItem { tag: "field_initial" },
    };
    io.stdout().writeln("  Reassigning holder.inner (expect drop of 'field_initial')...");
    holder.inner = DroppableItem { tag: "field_replaced" };

    io.stdout().writeln("[Test 1.4] Uninitialized struct field first assignment & reassignment:");
    let mut uninit_holder: DroppableHolder = uninit;
    io.stdout().writeln("  First assignment to uninit_holder.inner (expect NO drop)...");
    uninit_holder.inner = DroppableItem { tag: "uninit_holder_first" };
    io.stdout().writeln("  Reassigning uninit_holder.inner (expect drop of 'uninit_holder_first')...");
    uninit_holder.inner = DroppableItem { tag: "uninit_holder_second" };

    io.stdout().writeln("  Leaving test_assignment_drops scope (expect end-of-scope drops)...");
}

func test_array_and_slice_drops() {
    io.stdout().writeln("=== Running: test_array_and_slice_drops ===");

    io.stdout().writeln("[Test 2.1] Uninitialized array elements:");
    let mut arr: [3]DroppableItem = uninit;

    io.stdout().writeln("  Initializing arr[0] for first time (expect NO drop)...");
    arr[0] = DroppableItem { tag: "arr_0_original" };

    io.stdout().writeln("  Initializing arr[1] for first time (expect NO drop)...");
    arr[1] = DroppableItem { tag: "arr_1_original" };

    io.stdout().writeln("  Initializing arr[2] for first time (expect NO drop)...");
    arr[2] = DroppableItem { tag: "arr_2_original" };

    io.stdout().writeln("  Reassigning arr[0] (expect drop of 'arr_0_original')...");
    arr[0] = DroppableItem { tag: "arr_0_replacement" };

    io.stdout().writeln("[Test 2.2] Slice indexed assignment:");
    let s: &mut []DroppableItem = &mut arr[0..<3];
    io.stdout().writeln("  Assigning s[1] via slice (expect drop of 'arr_1_original')...");
    s[1] = DroppableItem { tag: "arr_1_via_slice" };

    io.stdout().writeln("  Leaving test_array_and_slice_drops scope (expect end-of-scope drops)...");
}

